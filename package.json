{
  "name": "gomate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GoMate - 极简地点组队平台 on Cloudflare Workers",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "astro dev --port ${GOMATE_WEB_PORT:-5432}",
    "dev:wt": "node scripts/start-worktree.mjs",
    "init:worktree": "node scripts/init-worktree.mjs",
    "build": "CLOUDFLARE_ENV=production astro build && cp .assetsignore dist/",
    "env:check": "node scripts/env-check.mjs",
    "check": "astro check",
    "lint": "eslint src scripts",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "test:server": "vitest run --config vitest.server.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:ci": "pnpm i18n:validate && pnpm db:check && pnpm lint && pnpm type-check && pnpm test && pnpm test:server && pnpm build && pnpm test:worker",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:ci": "CI=true playwright test --project=chromium",
    "i18n:build": "tsx scripts/build-locales.ts",
    "i18n:gen-types": "node scripts/gen-i18n-types.mjs",
    "i18n:validate": "node scripts/validate-i18n-keys.mjs",
    "db:generate": "drizzle-kit generate",
    "db:check": "node scripts/check-migrations-sync.mjs",
    "db:reset": "node scripts/reset-local-db.mjs",
    "db:promote-admin": "node scripts/promote-admin.mjs",
    "worker:types": "wrangler types src/server/worker-configuration.d.ts --config wrangler.jsonc --env production",
    "worker:dry-run": "node scripts/worker-dry-run.mjs",
    "worker:size": "node scripts/check-worker-bundle-size.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.3",
    "@astrojs/react": "^6.0.4",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.4",
    "better-auth": "^1.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.3",
    "lucide-react": "^0.460.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^4.0.0",
    "satori": "^0.12.0",
    "tailwind-merge": "^2.5.0",
    "tailwindcss": "^4.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "jsdom": "^29.0.2",
    "prettier": "^3.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
