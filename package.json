{
  "name": "gomate",
  "version": "0.1.0",
  "private": true,
  "description": "GoMate monorepo - 极简地点组队平台",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "api:dev": "NO_PROXY=* HTTP_PROXY= HTTPS_PROXY= pnpm --filter @gomate/api dev",
    "api:deploy": "pnpm --filter @gomate/api deploy",
    "web:dev": "pnpm --filter @gomate/frontend dev",
    "web:build": "pnpm --filter @gomate/frontend build",
    "mobile:dev": "cd mobile && flutter run",
    "mobile:ios": "xcrun simctl boot 8019EA08-4BD7-4254-97D6-0E31292A9DC5 2>/dev/null; open -a Simulator && cd mobile && flutter run -d 8019EA08-4BD7-4254-97D6-0E31292A9DC5",
    "mobile:android": "bash scripts/android-dev.sh",
    "mobile:test": "NO_PROXY=* HTTP_PROXY= HTTPS_PROXY= flutter test",
    "api:test": "pnpm --filter @gomate/api test",
    "api:test:coverage": "pnpm --filter @gomate/api test:coverage",
    "dev": "concurrently \"pnpm api:dev\" \"pnpm web:dev\"",
    "lint": "pnpm -r lint",
    "type-check": "pnpm -r type-check",
    "clean": "pnpm -r clean",
    "i18n:validate": "node scripts/validate-i18n-keys.mjs",
    "i18n:gen-types": "node scripts/gen-i18n-types.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "typescript": "^5"
  },
  "packageManager": "pnpm@9.0.0"
}
