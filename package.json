{
  "name": "gomate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "description": "GoMate - 极简地点组队平台 on Cloudflare Workers",
  "engines": {
    "node": ">=22.23.3"
  },
  "scripts": {
    "dev": "astro dev --port ${GOMATE_WEB_PORT:-5432}",
    "dev:wt": "node scripts/start-worktree.mjs",
    "init:worktree": "node scripts/init-worktree.mjs",
    "build": "node scripts/build-production.mjs",
    "env:check": "node scripts/env-check.mjs",
    "check": "astro check",
    "lint": "eslint src scripts",
    "type-check": "pnpm worker:types:generate && astro sync && tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "test:server": "vitest run --config vitest.server.config.ts",
    "test:worker": "pnpm build && pnpm test:worker:run",
    "test:worker:run": "vitest run --config vitest.worker.config.ts",
    "test:build-guard": "node --test scripts/toolchain.test.mjs scripts/preview-alias.test.mjs scripts/start-worktree.test.mjs scripts/ci-workflow-policy.test.mjs scripts/production-build-guard.test.mjs scripts/smoke-production-write-boundary.test.mjs scripts/validate-admin-i18n.test.mjs scripts/production-migrations.test.mjs",
    "test:db-reset": "node --test scripts/reset-local-db.test.mjs scripts/minimal-product-d1.test.mjs",
    "test:ci": "pnpm i18n:validate && pnpm test:build-guard && pnpm test:db-reset && pnpm db:check && pnpm lint && pnpm type-check && pnpm check && pnpm test && pnpm test:server && pnpm build && pnpm test:worker:run",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:ci": "CI=true playwright test --project=chromium",
    "i18n:build": "tsx scripts/build-locales.ts",
    "i18n:gen-types": "node scripts/gen-i18n-types.mjs",
    "i18n:validate": "node scripts/validate-i18n-keys.mjs && node scripts/validate-admin-i18n.mjs",
    "db:generate": "drizzle-kit generate",
    "db:check": "node scripts/check-migrations-sync.mjs",
    "db:reset": "node scripts/reset-local-db.mjs",
    "db:promote-admin": "node scripts/promote-admin.mjs",
    "worker:types:generate": "wrangler types src/server/worker-configuration.d.ts --config wrangler.jsonc --env production",
    "worker:types": "wrangler types src/server/worker-configuration.d.ts --config wrangler.jsonc --env production --check && git diff --exit-code -- src/server/worker-configuration.d.ts",
    "worker:dry-run": "node scripts/worker-dry-run.mjs",
    "worker:size": "node scripts/check-worker-bundle-size.mjs",
    "deploy:production": "node scripts/deploy-production.mjs",
    "deploy:preview": "node scripts/deploy-preview.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.4.0",
    "@astrojs/react": "7.1.0",
    "@hono/zod-openapi": "1.6.3",
    "@scalar/hono-api-reference": "0.12.13",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.4.0",
    "better-auth": "1.7.10",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "lucide-react": "1.59.0",
    "motion": "14.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "resend": "6.34.1",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "zod": "4.6.7",
    "@starwind-ui/react": "1.3.0",
    "tailwind-variants": "3.3.1",
    "@tabler/icons-react": "3.49.0",
    "@starwind-ui/astro": "1.3.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@cloudflare/vite-plugin": "1.64.0",
    "@cloudflare/vitest-plugin": "1.4.4",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@scalar/api-reference": "1.75.0",
    "@tailwindcss/typography": "0.5.20",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "drizzle-kit": "0.31.11",
    "es-module-lexer": "3.0.4",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.1"
  }
}
