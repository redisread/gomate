{
  "name": "@gomate/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0 --port 8799",
    "build": "tsc",
    "deploy": "wrangler deploy --env production",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@gomate/types": "workspace:*",
    "@hono/zod-validator": "^0.4.0",
    "@resvg/resvg-wasm": "^2.6.2",
    "better-auth": "^1.6.11",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.0",
    "kysely": "^0.28.5",
    "qrcode": "^1.5.4",
    "resend": "^4.0.0",
    "satori": "^0.12.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260409.1",
    "@eslint/js": "9",
    "@types/better-sqlite3": "^7.6.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.0",
    "@vitest/coverage-v8": "^2.0.0",
    "better-sqlite3": "^12.6.0",
    "drizzle-kit": "^0.28.0",
    "eslint": "9",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.58.1",
    "vitest": "^2.0.0",
    "wrangler": "^4.0.0"
  }
