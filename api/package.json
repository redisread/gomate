{
  "name": "@gomate/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./app": "./src/app.ts"
  },
  "scripts": {
    "build": "tsc",
    "type-check": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "check:migrations": "node scripts/check-migrations-sync.mjs"
  },
  "dependencies": {
    "@gomate/lib": "workspace:*",
    "@gomate/types": "workspace:*",
    "@hono/zod-validator": "^0.4.0",
    "better-auth": "^1.6.25",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.25",
    "kysely": "^0.28.5",
    "nanoid": "^5.1.16",
    "qrcode": "^1.5.4",
    "resend": "^4.0.0",
    "satori": "^0.12.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "9",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^25.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.0",
    "@vitest/coverage-v8": "^3.2.6",
    "better-sqlite3": "^12.6.0",
    "drizzle-kit": "^0.31.4",
    "eslint": "9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.1",
    "vitest": "^3.2.6",
    "wrangler": "^4.100.0"
  }
}
