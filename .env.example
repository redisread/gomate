# ==========================================
# GoMate 项目环境配置模板（参考清单）
# 本文件仅供查阅，不参与脚本加载。
# 本地开发实际读取位置：
#   - API secrets：api/.dev.vars（模板 api/.dev.vars.example）
#   - 前端变量：frontend/.env.local（模板 frontend/.env.local.example）
# 脚本消费关系：
#   - BETTER_AUTH_SECRET / PUBLIC_API_URL：scripts/env-check.mjs 校验
#     （经 api/.dev.vars 与 frontend/.env.local 读取）
#   - CLOUDFLARE_DATABASE_ID / CLOUDFLARE_D1_TOKEN：api/drizzle.config.ts
#     经 process.env 读取（drizzle-kit 远程 D1）
#   - CLOUDFLARE_ACCOUNT_ID：.github/workflows 使用同名 GitHub Actions secret
# ==========================================

# Cloudflare Account ID
# 在 Cloudflare Dashboard 右侧获取
CLOUDFLARE_ACCOUNT_ID=your-account-id

# Cloudflare D1 Database ID
# 创建 D1 数据库后获取: wrangler d1 list
CLOUDFLARE_DATABASE_ID=your-database-id

# Cloudflare D1 API Token
# 在 Cloudflare Dashboard -> My Profile -> API Tokens 创建
# 权限: D1:Edit
CLOUDFLARE_D1_TOKEN=your-api-token

# ==========================================
# Better Auth 认证配置
# ==========================================

# 生成命令: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key

# 本地开发时指向 API 地址（http://localhost:8799）
# 生产环境指向 https://api.gomate.live
BETTER_AUTH_URL=http://localhost:8799

# ==========================================
# 应用配置
# ==========================================

# 应用 URL（用于生成密码重置链接等）
# 本地开发：http://localhost:5432
# 生产环境：https://gomate.live
APP_URL=http://localhost:5432

# API URL（前端调用）
PUBLIC_API_URL=http://localhost:8799

# 高德地图 Key（地址地理编码）
# 注：前端 AMap 选点弹窗已移除，frontend/src 无消费方，
#     仅 frontend/astro.config.mjs 保留注入（本地可选）
PUBLIC_AMAP_KEY=

# ==========================================
# 邮件服务配置 (Resend)
# ==========================================

RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=GoMate <noreply@example.com>
