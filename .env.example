# GoMate CLI / CI environment reference. This file is not loaded automatically.
# Unified Worker local secrets belong in frontend/.dev.vars; copy the committed
# frontend/.dev.vars.example and never commit the populated file.

# Cloudflare administration. Production changes must follow
# docs/prod-change-policy.md and the protected GitHub environment.
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_DATABASE_ID=your-database-id
CLOUDFLARE_D1_TOKEN=your-api-token
CLOUDFLARE_API_TOKEN=your-workers-api-token

# Runtime secrets are shown here only as a deployment checklist. Local values
# are read from frontend/.dev.vars; production values are protected secrets.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
RESEND_API_KEY=your-resend-api-key
