---
import { getPageI18n } from "@/i18n/ssr-loader.server";
/**
 * 地点列表页
 */
import Layout from "../../layouts/Layout.astro";
import { readLocationFilters } from "../../components/features/locations/use-locations-list";
import { LocationsClient } from "../../components/features/locations/locations-main";
import { declareI18nNs } from "../../middleware";
import { serverApiGet } from "../../lib/server-api";
import type { LocationsListInitialData } from "../../components/features/locations/use-locations-list";
import type { Location, Region } from "../../lib/types";

declareI18nNs(Astro.locals, ["locations", "locationDetail", "filter", "content"]);

const params = Astro.url.searchParams;
const listQuery = new URLSearchParams();
listQuery.set("limit", "12");
if (params.get("cursor")) listQuery.set("cursor", params.get("cursor")!);
if (params.get("q")) listQuery.set("search", params.get("q")!);
if (params.get("tags")) listQuery.set("tagIds", params.get("tags")!);
if (params.get("regionId")) listQuery.set("regionId", params.get("regionId")!);
if (params.get("activityType")) listQuery.set("activityType", params.get("activityType")!);

const [locationsData, tagsData, regionsData] = await Promise.all([
  serverApiGet<{ success: boolean; locations: Location[]; total: number; nextCursor: string | null }>(Astro.request, Astro.locals, `/locations?${listQuery}`),
  serverApiGet<{ success: boolean; tags: { id: string; name: string }[] }>(Astro.request, Astro.locals, "/tags?limit=200"),
  serverApiGet<{ success: boolean; regions: Region[] }>(Astro.request, Astro.locals, "/regions?countryCode=CN&level=city&serviceEnabled=true"),
]);

const initialData = locationsData?.success
  ? {
      filters: readLocationFilters(params),
      cursor: params.get("cursor"),
      locations: locationsData.locations ?? [],
      pagination: {
        limit: 12,
        total: locationsData.total,
        nextCursor: locationsData.nextCursor,
      },
      popularTags: tagsData?.success ? tagsData.tags ?? [] : [],
      regions: regionsData?.success ? regionsData.regions ?? [] : [],
    } satisfies LocationsListInitialData
  : undefined;
---

<Layout tabNavigation titleKey="content.seo_pages.locations" showFooter={false}>
  <LocationsClient initialI18n={getPageI18n(Astro.locals)} initialData={initialData} client:visible />
</Layout>
