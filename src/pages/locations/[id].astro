---
/**
 * 地点详情页 - 动态路由
 */
import type { Location } from "../../contracts";
import Layout from "../../layouts/Layout.astro";
import { LocationDetailClient } from "../../components/features/location-detail-client";
import { ErrorBoundary } from "../../components/ui/error-boundary";
import { declareI18nNs } from "../../middleware";
import { serverApiGet } from "../../lib/server-api";

declareI18nNs(Astro.locals, ["locationDetail", "locations", "errors", "admin", "enums", "teams", "content"]);

const { id } = Astro.params;

// Reuse the public cover for link previews.
const locationResponse = await serverApiGet<{
  success: true;
  location: Location;
}>(Astro.request, Astro.locals, `/locations/${id}`);
const locationData = locationResponse?.success
  ? locationResponse.location ?? null
  : null;

const ogImage = locationData?.coverImageUrl ?? undefined;

const title = locationData?.name || undefined;

const description = locationData?.description
  ? locationData.description.slice(0, 160)
  : "发现精彩户外地点，组队一起出发！";
---

<Layout
  title={title}
  titleKey={title ? undefined : "content.seo_pages.locationDetail"}
  description={description}
  ogImage={ogImage}
  showNavbar={false}
  showFooter={false}
>
  <ErrorBoundary>
    <LocationDetailClient locationId={id!} client:visible />
  </ErrorBoundary>
</Layout>
