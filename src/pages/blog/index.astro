---
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
import { declareI18nNs } from "../../middleware";
import { loadLocaleData } from "../../i18n/ssr-loader.server";
import { type Locale, DEFAULT_LOCALE, SUPPORTED_LOCALES } from "../../i18n";

declareI18nNs(Astro.locals, ['blog', 'content']);

// Read locale from cookie (SSR)
const cookieLocale = Astro.cookies.get("gomate_locale")?.value as Locale | undefined;
const blogLocale: Locale = (cookieLocale && SUPPORTED_LOCALES.includes(cookieLocale)) ? cookieLocale : DEFAULT_LOCALE;

// Load blog namespace translations for SSR
let ssrT: (key: string) => string = (key: string) => key;
try {
  const origin = Astro.url.origin;
  const blogData = await loadLocaleData(['blog'], blogLocale, origin);
  // Simple SSR t() helper for this page
  const nsData = blogData['blog'] as Record<string, string> | undefined;
  ssrT = (key: string) => nsData?.[key] ?? key;
} catch {
  // Fallback to key
}

const allPosts = await getCollection("blog");
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

function formatDate(date: Date, locale: Locale) {
  const langMap: Record<Locale, string> = {
    "zh-CN": "zh-CN",
    "en": "en-US",
    "ja": "ja-JP",
  };
  return date.toLocaleDateString(langMap[locale], {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<Layout title={ssrT("title") + " - GoMate"} description={ssrT("description")}>
  <div class="min-h-screen bg-stone-50 dark:bg-stone-950">
    <!-- Header -->
    <header class="py-16 px-6">
      <div class="max-w-3xl mx-auto text-center">
        <h1 class="text-3xl font-medium text-stone-800 dark:text-stone-100 mb-3">{ssrT("title")}</h1>
        <p class="text-stone-500 dark:text-stone-400">{ssrT("description")}</p>
      </div>
    </header>

    <!-- Blog Posts -->
    <main class="px-6 pb-20">
      <div class="max-w-2xl mx-auto">
        <div class="space-y-12">
          {sortedPosts.map((post) => (
            <article class="group">
              <a href={`/blog/${post.id}`} class="block">
                <!-- Title -->
                <h2 class="text-xl font-medium text-stone-800 dark:text-stone-100 mb-2 group-hover:text-amber-700 dark:group-hover:text-amber-400 transition-colors">
                  {post.data.title}
                </h2>

                <!-- Description -->
                <p class="text-stone-500 dark:text-stone-400 mb-3 leading-relaxed">
                  {post.data.description}
                </p>

                <!-- Date -->
                <time class="text-sm text-stone-400 dark:text-stone-500">
                  {formatDate(post.data.pubDate, blogLocale)}
                </time>
              </a>
            </article>
          ))}
        </div>

        <!-- Empty State -->
        {sortedPosts.length === 0 && (
          <div class="text-center py-20 text-stone-400 dark:text-stone-500">
            <p>{ssrT("noArticles")}</p>
          </div>
        )}
      </div>
    </main>
  </div>
</Layout>
