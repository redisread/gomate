---
/**
 * 登录页
 */
import { env } from "cloudflare:workers";
import { isGoogleAuthAvailable } from "../server/lib/google-auth";
import Layout from "../layouts/Layout.astro";
import { LoginClient } from "../components/features/login-client";
import { declareI18nNs } from "../middleware";

declareI18nNs(Astro.locals, ["auth", "content"]);
---

<Layout
  titleKey="content.seo_pages.login"
  showNavbar={false}
  showFooter={false}
>
  <LoginClient googleEnabled={isGoogleAuthAvailable(Astro.request, env)} client:load />
</Layout>
