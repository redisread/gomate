---
/**
 * 登录页
 */
import { env } from "cloudflare:workers";
import { isGoogleAuthAvailable } from "../server/lib/google-auth";
import { resolveLoginReturnPath } from "../lib/login-return-path";
import Layout from "../layouts/Layout.astro";
import { LoginClient } from "../components/features/login-client";
import { declareI18nNs } from "../middleware";

declareI18nNs(Astro.locals, ["auth", "content"]);
const target = resolveLoginReturnPath(Astro.url.searchParams.get("returnTo") ?? Astro.url.searchParams.get("redirect"));
const returnTo = Astro.locals.locale === "en" && !/^\/(en|zh-CN)(?:\/|$)/u.test(target) ? `/en${target}` : target;
Astro.response.headers.set("Cache-Control", "private, no-store");
---

<Layout
  titleKey="content.seo_pages.login"
  showNavbar={false}
  showFooter={false}
>
  <LoginClient returnTo={returnTo} googleEnabled={isGoogleAuthAvailable(Astro.request, env)} client:load />
</Layout>
