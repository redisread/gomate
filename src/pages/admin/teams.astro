---
import { AdminTeamsManager } from "../../components/admin/admin-teams-manager";
import { getSSRT, resolveLocale } from "../../i18n";
import { loadLocaleData } from "../../i18n/ssr-loader.server";
import AdminLayout from "../../layouts/AdminLayout.astro";
import { readAdminTeamFilters } from "../../lib/admin-team-filters";
import { declareI18nNs } from "../../middleware";

declareI18nNs(Astro.locals, ["admin", "enums", "teams"]);
const locale = resolveLocale(Astro.locals.locale || Astro.cookies.get("gomate_locale")?.value);
const data = await loadLocaleData(["admin"], locale, Astro.url.origin);
const t = getSSRT(locale, { [locale]: data } as never).t;
const title = t("admin.teamsManagement.title");
const initialFilters = readAdminTeamFilters(Astro.url.searchParams);
---

<AdminLayout title={title} description={t("admin.teamsManagement.description")}>
  <header class="mb-8 space-y-2">
    <h1 class="text-3xl font-bold tracking-tight">{title}</h1>
    <p class="max-w-2xl text-muted-foreground">{t("admin.teamsManagement.description")}</p>
  </header>
  <AdminTeamsManager initialFilters={initialFilters} client:load />
</AdminLayout>
