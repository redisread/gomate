---
/**
 * 队伍详情页 - Partiful 风格
 */
import type { TeamResponse } from "../../contracts/team-api";
import Layout from "../../layouts/Layout.astro";
import { TeamDetailPartiful } from "../../components/features/team-detail/team-detail-main";
import { declareI18nNs } from "../../middleware";
import { serverApiGet } from "../../lib/server-api";

declareI18nNs(Astro.locals, ["teams", "locationDetail", "enums", "profile", "errors", "content"]);

const { id } = Astro.params;

const data = id
  ? await serverApiGet<TeamResponse>(Astro.request, Astro.locals, `/teams/${id}`)
  : null;
const teamData = data?.success && data.team ? data.team : null;

const ogImage = teamData?.location?.coverImageUrl ?? undefined;

const title = teamData?.title
  ? teamData.title
  : "队伍详情 - GoMate";

const description = teamData?.description
  ? teamData.description.slice(0, 160)
  : "加入队伍，一起探索户外精彩！";
---

<Layout
  title={title}
  description={description}
  ogImage={ogImage}
  showNavbar={false}
  showFooter={false}
>
  <TeamDetailPartiful teamId={id!} client:visible />
</Layout>
