---
/**
 * 注册页
 */
import { env } from "cloudflare:workers";
import { isGoogleAuthAvailable } from "../server/lib/google-auth";
import Layout from "../layouts/Layout.astro";
import { RegisterClient } from "../components/features/register-client";
import { declareI18nNs } from "../middleware";

declareI18nNs(Astro.locals, ["auth", "content"]);
---

<Layout
  titleKey="content.seo_pages.register"
  showNavbar={false}
  showFooter={false}
>
  <RegisterClient googleEnabled={isGoogleAuthAvailable(Astro.request, env)} client:load />
</Layout>
