---
/**
 * 用户详情页 - 动态路由
 */
import Layout from "../../layouts/Layout.astro";
import { UserDetailClient } from "../../components/features/user-detail-client";
import { declareI18nNs } from "../../middleware";

declareI18nNs(Astro.locals, ["userDetail", "profile", "errors", "enums", "content"]);

const { id } = Astro.params;
---

<Layout titleKey="content.seo_pages.userDetail" showNavbar={false} showFooter={false}>
  <UserDetailClient userId={id!} client:load />
</Layout>
