---
import { getPageI18n } from "@/i18n/ssr-loader.server";
/**
 * 首页 - GoMate
 */
import Layout from "../layouts/Layout.astro";
import { HomeClient } from "../components/features/home/home-main";
import { declareI18nNs } from "../middleware";
import { serverApiGet } from "../lib/server-api";
import type { HomeInitialData } from "../components/features/home/use-home-data";
import type { LocationsResponse } from "../hooks/use-locations";
import type { Team } from "../lib/types";
import { homeTeamQuery } from "../components/features/home/team-query";
declareI18nNs(Astro.locals, ["home", "locations", "locationDetail", "teams", "enums", "content"]);

const [locationsData, teamsData] = await Promise.all([
  serverApiGet<LocationsResponse>(Astro.request, Astro.locals, "/locations?limit=6&view=card"),
  serverApiGet<{ success: boolean; teams: Team[] }>(Astro.request, Astro.locals, homeTeamQuery()),
]);

const initialData: HomeInitialData = {
  locations: locationsData?.success ? locationsData : null,
  teams: teamsData?.success ? teamsData.teams ?? [] : undefined,
};
---

<Layout tabNavigation titleKey="content.title">
  <HomeClient initialI18n={getPageI18n(Astro.locals)} initialData={initialData} initialTimeZone={Intl.DateTimeFormat().resolvedOptions().timeZone} client:visible />
</Layout>
