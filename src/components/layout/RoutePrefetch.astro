<script>
  // Prefetch expressed intent only; idle visits must not trigger extra SSR/DB work.
  const seen = new Set<string>();
  let timer: ReturnType<typeof setTimeout> | undefined;
  const connection = (navigator as Navigator & {
    connection?: { saveData?: boolean; effectiveType?: string };
  }).connection;

  function candidate(event: Event): HTMLAnchorElement | null {
    const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>("a[href]") : null;
    if (!link || link.download || (link.target && link.target !== "_self")) return null;
    const url = new URL(link.href);
    if (url.origin !== location.origin || url.pathname === location.pathname && url.search === location.search) return null;
    const route = url.pathname.replace(/^\/en(?=\/|$)/, "") || "/";
    if (!/^\/(?:locations(?:\/[^/]+)?|teams(?:\/[^/]+)?|about|privacy|terms|blog(?:\/[^/]+)?)?$/.test(route) || route === "/teams/create") return null;
    return link;
  }

  function prefetch(link: HTMLAnchorElement) {
    if (connection?.saveData || /(^|-)2g$/.test(connection?.effectiveType ?? "") || seen.size >= 8) return;
    const url = new URL(link.href);
    url.hash = "";
    if (seen.has(url.href)) return;
    seen.add(url.href);
    const hint = document.createElement("link");
    hint.rel = "prefetch";
    hint.as = "document";
    hint.href = url.href;
    document.head.appendChild(hint);
  }

  document.addEventListener("pointerover", (event) => {
    clearTimeout(timer);
    if (event.pointerType !== "mouse") return;
    const link = candidate(event);
    if (link) timer = setTimeout(() => prefetch(link), 120);
  }, { passive: true });
  document.addEventListener("pointerout", () => clearTimeout(timer), { passive: true });
  document.addEventListener("focusin", (event) => {
    const link = candidate(event);
    if (link) prefetch(link);
  });
</script>
