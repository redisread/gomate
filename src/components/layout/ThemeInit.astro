---
// Runs before body rendering; system preference is resolved in the browser.
---
<script is:inline>
      (function () {
        try {
          var match = document.cookie.match(/theme=(light|dark|system)/);
          var theme = match ? match[1] : 'system';
          var isDark;
          if (theme === 'dark') {
            isDark = true;
          } else if (theme === 'light') {
            isDark = false;
          } else {
            isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          }
          if (isDark) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch {
          // Keep the server-rendered theme when browser preferences are unavailable.
        }
      })();
    </script>
