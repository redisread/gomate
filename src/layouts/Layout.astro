---
// Shared document shell. Theme tokens live in globals.css.
import "../styles/globals.css";
import ThemeInit from "../components/layout/ThemeInit.astro";
import RoutePrefetch from "../components/layout/RoutePrefetch.astro";
import { resolvePageMetadata, type PageMetadataProps } from "../lib/page-metadata";
import { PublicNavbar } from "../components/layout/public-navbar";
import { Footer } from "../components/layout/footer";
import {
  DEFAULT_LOCALE,
  getSSRT,
  resolveLocale,
  SUPPORTED_LOCALES,
  type Locale,
} from "../i18n";
import { loadLocaleData } from "../i18n/ssr-loader.server";

interface Props extends PageMetadataProps {
  /** Open Graph image URL */
  ogImage?: string;
  /** 是否显示导航栏，默认 true */
  showNavbar?: boolean;
  /** 是否显示页脚，默认 true */
  showFooter?: boolean;
}

const {
  title: propTitle,
  titleKey,
  description: propDesc,
  descriptionKey,
  ogImage,
  showNavbar = true,
  showFooter = true,
} = Astro.props;
const resolvedOgImage = ogImage
  ? new URL(ogImage, Astro.url.origin).toString()
  : undefined;

// 从 middleware 设置的 locals 或 cookie 读取 locale
const localsLocale = Astro.locals.locale;
const cookieLocale = Astro.cookies.get("gomate_locale")?.value;
const locale = resolveLocale(localsLocale || cookieLocale);
// ─── SSR i18n 数据加载 ──────────────────────────────────────────────
// 从 locals 读取页面声明的 namespaces
const declaredNs = Astro.locals.__i18n_namespaces || [];
// 注入全局 namespace（nav/common 用于 Navbar/Footer）+ content（用于 SEO 标题）
const nsList = [...new Set([...declaredNs, "nav", "common", "content", "admin"])];
const ssrLoadedData = await loadLocaleData(nsList, locale, Astro.url.origin);
const ssrLocaleData = { [locale]: ssrLoadedData };

const ssr = getSSRT(locale, ssrLocaleData);

const { title, description } = resolvePageMetadata(
  { title: propTitle, titleKey, description: propDesc, descriptionKey },
  ssr.t,
);

// 读取主题 cookie，服务端设置 html class
const themeCookie = Astro.cookies.get("theme")?.value;
const isDark = themeCookie === "dark"; // 默认 light，客户端会校正

// 获取当前路径（不含 locale 前缀）
const url = new URL(Astro.request.url);
const canonicalUrl = new URL(Astro.url);
canonicalUrl.search = "";
canonicalUrl.hash = "";
const pathSegments = url.pathname.split("/").filter(Boolean);
const hasLocalePrefix = SUPPORTED_LOCALES.includes(pathSegments[0] as Locale);
const cleanSegments = hasLocalePrefix ? pathSegments.slice(1) : pathSegments;
const cleanPath = "/" + cleanSegments.join("/");

// 生成 hreflang 链接
function getHreflangUrl(loc: Locale) {
  if (loc === "zh-CN") {
    return `https://gomate.live${cleanPath === "/" ? "/" : cleanPath}`;
  }
  return `https://gomate.live/${loc}${cleanPath === "/" ? "" : cleanPath}`;
}
---

<!doctype html>
<html lang={locale} class={isDark ? "dark" : ""}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="var(--background)" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="var(--background)" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href="/favicon.ico?v=5" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=5" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=5" />

    {/* Open Graph meta tags */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl.href} />
    {resolvedOgImage && <meta property="og:image" content={resolvedOgImage} />}

    {/* Twitter Card meta tags */}
    <meta name="twitter:card" content={resolvedOgImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {resolvedOgImage && <meta name="twitter:image" content={resolvedOgImage} />}

    {/* R2 存储预连接（图片加载优化） */}
    <link rel="dns-prefetch" href="https://cos.gomate.live" />
    <link rel="preconnect" href="https://cos.gomate.live" crossorigin />

    {/* hreflang alternate links */}
    {SUPPORTED_LOCALES.map((loc) => (
      <link rel="alternate" hreflang={loc} href={getHreflangUrl(loc)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={getHreflangUrl(DEFAULT_LOCALE)} />

    <ThemeInit />

    {/* SSR i18n 内联数据 */}
    <script is:inline set:html={`window.__I18N_DATA__=${JSON.stringify(ssrLocaleData)};`}></script>

    <RoutePrefetch />

  </head>
  <body class="min-h-screen bg-background">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-lg focus:bg-amber-600 focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-white focus:shadow-lg"
    >
      {ssr.t("common.skipToContent")}
    </a>
    {showNavbar && <PublicNavbar initialI18n={{ locale, namespaces: { nav: ssrLoadedData.nav, common: ssrLoadedData.common, admin: ssrLoadedData.admin } }} client:load />}
    {/*
      #main-content 是 skip-link 锚点，不是 <main>：
      各 page/组件（skeleton.tsx、create-team、home-main 等）自带 <main> landmark，
      Layout 层再包 <main> 会造成嵌套双 landmark。tabindex=-1 让键盘焦点可跳到内容起点。
    */}
    <div id="main-content" tabindex="-1" class="outline-none">
      <slot />
    </div>
    {showFooter && <Footer initialI18n={{ locale, namespaces: { common: ssrLoadedData.common } }} client:idle />}
  </body>
</html>
