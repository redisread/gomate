# ==========================================
# GoMate 项目环境配置
# ==========================================

# ==========================================
# CloudFlare D1 数据库配置
# ==========================================

# CloudFlare Account ID
# 在 Cloudflare Dashboard 右侧获取
CLOUDFLARE_ACCOUNT_ID=your-account-id

# D1 Database ID
# 创建 D1 数据库后获取: wrangler d1 list
CLOUDFLARE_DATABASE_ID=your-database-id

# D1 API Token
# 在 Cloudflare Dashboard -> My Profile -> API Tokens 创建
# 权限: D1:Edit
CLOUDFLARE_D1_TOKEN=your-api-token

# ==========================================
# 本地开发配置
# ==========================================

# 本地开发模式 - 启用本地 D1 模拟（推荐用于开发）
# 运行 `npm run cf:dev` 时自动启用
# LOCAL_D1_ENABLED=true

# 开发模式说明：
# - `npm run dev` 使用 next dev + Turbopack（通过 initOpenNextCloudflareForDev 模拟 D1/R2）
# - `npm run cf:dev` 使用 wrangler dev（完整 Cloudflare 模拟）

# ==========================================
# Better Auth 认证配置
# ==========================================

