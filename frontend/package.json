{
  "name": "@gomate/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-vditor-assets.mjs && astro dev --port ${GOMATE_WEB_PORT:-5432}",
    "i18n:build": "cd .. && pnpm i18n:build",
    "build": "pnpm i18n:build && node scripts/copy-vditor-assets.mjs && CLOUDFLARE_ENV=production astro build && cp .assetsignore dist/",
    "preview": "astro preview",
    "check": "pnpm i18n:build && astro check",
    "type-check": "pnpm i18n:build && astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "worker:types": "wrangler types ../api/src/worker-configuration.d.ts --config wrangler.jsonc --env production",
    "worker:types:check": "wrangler types ../api/src/worker-configuration.d.ts --config wrangler.jsonc --env production --check",
    "worker:dry-run": "node ../scripts/prepare-worker-output.mjs && wrangler deploy --dry-run --outdir ../dist-worker",
    "worker:size": "node ../scripts/check-worker-bundle-size.mjs",
    "worker:startup": "wrangler check startup",
    "i18n:gen-types": "node ../scripts/gen-i18n-types.mjs",
    "i18n:validate": "node ../scripts/validate-i18n-keys.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.7.0",
    "@astrojs/react": "^5.0.7",
    "@gomate/api": "workspace:*",
    "@gomate/types": "workspace:*",
    "@nanostores/persistent": "^1.3.3",
    "@nanostores/react": "^1.1.0",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^6.4.6",
    "better-auth": "^1.6.25",
    "clsx": "^2.1.1",
    "hono": "^4.12.25",
    "lucide-react": "^0.460.0",
    "nanostores": "^1.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.5.0",
    "tailwindcss": "^4.0.0",
    "vditor": "^3.11.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/sitemap": "^3.7.2",
    "@eslint/js": "9",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "9",
    "eslint-plugin-react-hooks": "5",
    "jsdom": "^29.0.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.1",
    "vite": "^7.3.6",
    "vitest": "^3.2.6",
    "wrangler": "^4.100.0"
  }
}
