{
  "name": "@gomate/frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "i18n:build": "cd .. && pnpm i18n:build",
    "build": "pnpm i18n:build && astro build && cp .assetsignore dist/",
    "preview": "astro preview",
    "check": "pnpm i18n:build && astro check",
    "type-check": "pnpm i18n:build && astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/",
    "i18n:gen-types": "node ../scripts/gen-i18n-types.mjs",
    "i18n:validate": "node ../scripts/validate-i18n-keys.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.1",
    "@astrojs/react": "^6.0.1",
    "@gomate/types": "workspace:*",
    "@nanostores/persistent": "^1.3.3",
    "@nanostores/react": "^1.1.0",
    "@tailwindcss/vite": "^4.2.2",
    "astro": "^7.0.6",
    "better-auth": "^1.6.11",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "nanostores": "^1.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.5.0",
    "tailwindcss": "^4.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/sitemap": "^3.7.3",
    "@eslint/js": "9",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/expect": "4.1.9",
    "eslint": "9",
    "eslint-plugin-react-hooks": "5",
    "jsdom": "^29.0.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.1.3",
    "vitest": "^4.1.9",
    "wrangler": "^4.107.0"
  }
}
