---
/**
 * 主布局 - 包含 HTML 骨架、全局样式和 React 导航栏
 */
import "../styles/globals.css";
import { Navbar } from "../components/layout/navbar";
import { Footer } from "../components/layout/footer";
import { DEFAULT_LOCALE, type Locale, SUPPORTED_LOCALES, getSSRT } from "../i18n";
import { loadLocaleData } from "../i18n/ssr-loader";

interface Props {
  title?: string;
  description?: string;
  /** 是否显示导航栏，默认 true */
  showNavbar?: boolean;
  /** 是否显示页脚，默认 true */
  showFooter?: boolean;
}

const {
  title: propTitle = "GoMate - 发现趣处，组队同行",
  description: propDesc = "GoMate 是一个极简的「地点组队」平台，帮助户外爱好者找到志同道合的徒步伙伴。",
  showNavbar = true,
  showFooter = true,
} = Astro.props;

// 从 middleware 设置的 locals 或 cookie 读取 locale
const localsLocale = (Astro.locals as any)?.locale as Locale | undefined;
const cookieLocale = Astro.cookies.get("gomate_locale")?.value as Locale | undefined;
const resolvedLocale = localsLocale || cookieLocale;
const locale: Locale = (resolvedLocale && SUPPORTED_LOCALES.includes(resolvedLocale)) ? resolvedLocale : DEFAULT_LOCALE;

// ─── SSR i18n 数据加载 ──────────────────────────────────────────────
// 从 locals 读取页面声明的 namespaces
const declaredNs = (Astro.locals as any)?.__i18n_namespaces || [];
// 注入全局 namespace（nav/common 用于 Navbar/Footer）+ content（用于 SEO 标题）
const nsList = [...new Set([...declaredNs, "nav", "common", "content"])];
let ssrLocaleData: Record<Locale, Record<string, Record<string, unknown>>> = {} as any;
let ssrLoadedData: Record<string, Record<string, unknown>> | undefined;
try {
  const origin = Astro.url.origin;
  ssrLoadedData = await loadLocaleData(nsList, locale, origin);
  ssrLocaleData = { [locale]: ssrLoadedData } as Record<Locale, Record<string, Record<string, unknown>>>;
} catch {
  // SSR 加载失败，客户端会 fallback 到 fetch
}

const ssr = getSSRT(locale, ssrLocaleData);

// 页面级标题映射
const titleMap: Record<string, string> = {
  "GoMate - 发现趣处，组队同行": "content.title",
  "GoMate 是一个极简的「地点组队」平台，帮助户外爱好者找到志同道合的徒步伙伴。": "content.description",
  "探索地点 - GoMate": "content.seo_pages.locations",
  "探索队伍 - GoMate": "content.seo_pages.teams",
  "登录 - GoMate": "content.seo_pages.login",
  "注册 - GoMate": "content.seo_pages.register",
  "忘记密码 - GoMate": "content.seo_pages.forgotPassword",
  "重置密码 - GoMate": "content.seo_pages.resetPassword",
  "个人资料 - GoMate": "content.seo_pages.profile",
  "编辑资料 - GoMate": "content.seo_pages.profileEdit",
  "我的队伍 - GoMate": "content.seo_pages.myTeams",
  "发布队伍 - GoMate": "content.seo_pages.createTeam",
  "编辑队伍 - GoMate": "content.seo_pages.editTeam",
  "地点详情 - GoMate": "content.seo_pages.locationDetail",
  "队伍详情 - GoMate": "content.seo_pages.teamDetail",
  "我的收藏 - GoMate": "content.seo_pages.favorites",
  "用户资料 - GoMate": "content.seo_pages.userDetail",
  "联系我们 - GoMate": "content.seo_pages.contact",
  "反馈建议 - GoMate": "content.seo_pages.feedback",
  "关于我们 - GoMate": "content.seo_pages.about",
  "帮助中心 - GoMate": "content.seo_pages.help",
  "隐私政策 - GoMate": "content.seo_pages.privacy",
  "服务条款 - GoMate": "content.seo_pages.terms",
  "管理地点 - GoMate": "content.seo_pages.adminLocations",
};

const titleKey = titleMap[propTitle];
const descKey = titleMap[propDesc];

// 标题逻辑：如果传入的是默认标题则翻译，否则拼接翻译后缀
const title = titleKey ? ssr.t(titleKey as any) : `${propTitle}${ssr.t("content.titleSuffix" as any)}`;
const description = descKey ? ssr.t(descKey as any) : propDesc;

// 读取主题 cookie，服务端设置 html class
const themeCookie = Astro.cookies.get("theme")?.value;
const isDark = themeCookie === "dark" || (!themeCookie && false); // 默认 light，客户端会校正

// 获取当前路径（不含 locale 前缀）
const url = new URL(Astro.request.url);
const pathSegments = url.pathname.split("/").filter(Boolean);
const hasLocalePrefix = SUPPORTED_LOCALES.includes(pathSegments[0] as Locale);
const cleanSegments = hasLocalePrefix ? pathSegments.slice(1) : pathSegments;
const cleanPath = "/" + cleanSegments.join("/");

// 生成 hreflang 链接
function getHreflangUrl(loc: Locale) {
  if (loc === "zh-CN") {
    return `https://gomate.live${cleanPath === "/" ? "/" : cleanPath}`;
  }
  return `https://gomate.live/${loc}${cleanPath === "/" ? "" : cleanPath}`;
}
---

<!doctype html>
<html lang={locale} class={isDark ? "dark" : ""}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />

    {/* hreflang alternate links */}
    {SUPPORTED_LOCALES.map((loc) => (
      <link rel="alternate" hreflang={loc} href={getHreflangUrl(loc)} />
    ))}
    <link rel="alternate" hreflang="x-default" href={getHreflangUrl(DEFAULT_LOCALE)} />

    <script is:inline>
      (function () {
        try {
          var match = document.cookie.match(/theme=(light|dark|system)/);
          var theme = match ? match[1] : 'system';
          var isDark;
          if (theme === 'dark') {
            isDark = true;
          } else if (theme === 'light') {
            isDark = false;
          } else {
            isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          }
          if (isDark) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {}
      })();
    </script>

    {/* SSR i18n 内联数据 */}
    <script is:inline set:html={`window.__I18N_DATA__=${JSON.stringify(ssrLocaleData)};`}></script>

    {/* 客户端 hydration 时优先读取 SSR 内联数据 */}
    <script is:inline>
      (function() {
        const ssrData = window.__I18N_DATA__;
        if (!ssrData) return;

        // 内联 hydrateSSRData 逻辑：将 SSR 数据写入内存缓存
        // 注意：这里模拟 i18n/index.ts 中的内存缓存逻辑
        if (typeof window !== 'undefined') {
          window.__I18N_MEMORY_CACHE__ = window.__I18N_MEMORY_CACHE__ || new Map();
          for (const [locale, nsMap] of Object.entries(ssrData)) {
            for (const [ns, nsData] of Object.entries(nsMap)) {
              const memKey = `${locale}:${ns}`;
              const entry = {
                data: nsData,
                expiresAt: Date.now() + 24 * 60 * 60 * 1000 // 24h TTL
              };
              window.__I18N_MEMORY_CACHE__.set(memKey, entry);
            }
          }
          // 清理全局变量避免重复处理
          delete window.__I18N_DATA__;
        }
      })();
    </script>
  </head>
  <body class={["min-h-screen", isDark ? "dark bg-[#12100d]" : "bg-[#faf8f5]"].join(" ")}>
    {showNavbar && <Navbar client:load />}
    <slot />
    {showFooter && <Footer client:load />}
  </body>
</html>
