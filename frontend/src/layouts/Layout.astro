---
/**
 * 主布局 - 包含 HTML 骨架、全局样式和 React 导航栏
 */
import "../styles/globals.css";
import { Navbar } from "../components/layout/navbar";
import { Footer } from "../components/layout/footer";

interface Props {
  title?: string;
  description?: string;
  /** 是否显示导航栏，默认 true */
  showNavbar?: boolean;
  /** 是否显示页脚，默认 true */
  showFooter?: boolean;
}

const {
  title = "GoMate - 极简地点组队平台",
  description = "GoMate 是一个极简的「地点组队」平台，帮助户外爱好者找到志同道合的徒步伙伴。",
  showNavbar = true,
  showFooter = true,
} = Astro.props;

// 读取主题 cookie，服务端设置 html class
const themeCookie = Astro.cookies.get("theme")?.value;
const isDark = themeCookie === "dark" || (!themeCookie && false); // 默认 light，客户端会校正
---

<!doctype html>
<html lang="zh-CN" class={isDark ? "dark" : ""}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <script is:inline>
      (function () {
        try {
          var match = document.cookie.match(/theme=(light|dark|system)/);
          var theme = match ? match[1] : 'system';
          var isDark;
          if (theme === 'dark') {
            isDark = true;
          } else if (theme === 'light') {
            isDark = false;
          } else {
            isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          }
          if (isDark) {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body class="min-h-screen">
    {showNavbar && <Navbar client:load />}
    <slot />
    {showFooter && <Footer client:load />}
  </body>
</html>
