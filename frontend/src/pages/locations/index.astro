---
/**
 * 地点列表页
 */
import Layout from "../../layouts/Layout.astro";
import { LocationsClient } from "../../components/features/locations-client";
import { declareI18nNs } from "../../middleware";
import { serverApiGet } from "../../lib/server-api";
import type { LocationsListInitialData } from "../../components/features/locations/use-locations-list";
import type { Location, Region } from "../../lib/types";

declareI18nNs(Astro.locals, ["locations", "locationDetail", "filter", "content"]);

const fetchJson = <T,>(path: string) =>
  serverApiGet<T>(Astro.request, Astro.locals, path);

const params = Astro.url.searchParams;
const listQuery = new URLSearchParams();
listQuery.set("limit", "12");
if (params.get("q")) listQuery.set("search", params.get("q")!);
if (params.get("tags")) listQuery.set("tagIds", params.get("tags")!);
if (params.get("regionId")) listQuery.set("regionId", params.get("regionId")!);
if (params.get("activityType")) listQuery.set("activityType", params.get("activityType")!);

const [locationsData, tagsData, regionsData] = await Promise.all([
  fetchJson<{ success: boolean; locations: Location[]; total: number; nextCursor: string | null }>(`/locations?${listQuery}`),
  fetchJson<{ success: boolean; tags: { id: string; name: string }[] }>("/tags?limit=200"),
  fetchJson<{ success: boolean; regions: Region[] }>("/regions?countryCode=CN&level=city&serviceEnabled=true"),
]);

const initialData = locationsData?.success
  ? {
      locations: locationsData.locations ?? [],
      pagination: {
        limit: 12,
        total: locationsData.total,
        nextCursor: locationsData.nextCursor,
      },
      popularTags: tagsData?.success ? tagsData.tags ?? [] : [],
      regions: regionsData?.success ? regionsData.regions ?? [] : [],
    } satisfies LocationsListInitialData
  : undefined;
---

<Layout title="探索地点 - GoMate" showNavbar={false} showFooter={false}>
  <LocationsClient initialData={initialData} client:visible />
</Layout>
