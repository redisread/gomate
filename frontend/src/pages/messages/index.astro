---
/**
 * 消息中心页
 */
import Layout from "../../layouts/Layout.astro";
import { declareI18nNs } from "../../middleware";
import { DEFAULT_LOCALE, SUPPORTED_LOCALES, getSSRT, type Locale } from "../../i18n";
import { loadLocaleData } from "../../i18n/ssr-loader.server";

declareI18nNs(Astro.locals, ["messages", "common"]);

const localsLocale = (Astro.locals as any)?.locale as Locale | undefined;
const cookieLocale = Astro.cookies.get("gomate_locale")?.value as Locale | undefined;
const resolvedLocale = localsLocale || cookieLocale;
const locale: Locale = (resolvedLocale && SUPPORTED_LOCALES.includes(resolvedLocale))
  ? resolvedLocale
  : DEFAULT_LOCALE;
const loadedData = await loadLocaleData(["messages"], locale, Astro.url.origin);
const ssr = getSSRT(locale, { [locale]: loadedData } as Record<Locale, Record<string, Record<string, unknown>>>);
const dateLocale = locale === "zh-CN" ? "zh-CN" : "en-US";
const apiBase = import.meta.env.PUBLIC_API_URL || "http://localhost:8799";
const copy = {
  centerTitle: ssr.t("messages.centerTitle"),
  loading: ssr.t("messages.loading"),
  loadingConversations: ssr.t("messages.loadingConversations"),
  emptyTitle: ssr.t("messages.emptyTitle"),
  emptyDescription: ssr.t("messages.emptyDescription"),
  discover: ssr.t("messages.discover"),
  unknownUser: ssr.t("messages.unknownUser"),
  noMessages: ssr.t("messages.noMessages"),
  retry: ssr.t("messages.retry"),
  loadFailed: ssr.t("messages.loadFailed"),
  centerForbidden: ssr.t("messages.centerForbidden"),
  refresh: ssr.t("messages.refresh"),
  conversationList: ssr.t("messages.conversationList"),
  openConversation: ssr.t("messages.openConversation"),
  unreadMessages: ssr.t("messages.unreadMessages"),
  yesterday: ssr.t("messages.yesterday"),
};
---

<Layout title="消息中心 - GoMate" showNavbar={true} showFooter={false}>
  <div class="min-h-screen bg-background text-foreground">
    <div class="mx-auto min-h-screen max-w-2xl border-x border-border/70 bg-card/60">
      <div class="sticky top-0 z-10 border-b border-border bg-background/95 px-4 py-3 backdrop-blur sm:px-5">
        <div class="flex items-center justify-between gap-3">
          <h1 class="text-lg font-semibold leading-tight text-foreground">
            {copy.centerTitle}
          </h1>
          <button
            id="refreshBtn"
            type="button"
            aria-label={copy.refresh}
            title={copy.refresh}
            class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-muted-foreground transition-colors hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background disabled:cursor-not-allowed disabled:opacity-60"
          >
            <svg id="refreshIcon" class="h-4.5 w-4.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
          </button>
        </div>
      </div>

      <div
        id="messageList"
        role="list"
        aria-label={copy.conversationList}
        aria-busy="true"
        class="min-h-[calc(100vh-132px)] divide-y divide-border/70"
      >
        <div role="status" aria-label={copy.loadingConversations} class="divide-y divide-border/70">
          {Array.from({ length: 4 }).map(() => (
            <div class="flex items-center gap-3 px-4 py-3.5 sm:px-5">
              <div class="h-12 w-12 shrink-0 animate-pulse rounded-full bg-muted"></div>
              <div class="min-w-0 flex-1 space-y-2">
                <div class="h-3.5 w-1/3 animate-pulse rounded bg-muted"></div>
                <div class="h-3 w-2/3 animate-pulse rounded bg-muted"></div>
              </div>
            </div>
          ))}
          <span class="sr-only">{copy.loading}</span>
        </div>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ API_BASE: apiBase, copy, dateLocale }}>
    const messageListEl = document.getElementById("messageList");
    const refreshBtn = document.getElementById("refreshBtn");
    const refreshIcon = document.getElementById("refreshIcon");

    let conversationsRequestInFlight = false;
    let pollTimer = null;

    function startPolling() {
      if (pollTimer) return;
      pollTimer = window.setInterval(() => loadConversations(), 30000);
    }

    function stopPolling() {
      if (pollTimer) {
        clearInterval(pollTimer);
        pollTimer = null;
      }
    }

    async function init() {
      try {
        const sessionRes = await fetch(`${API_BASE}/auth/get-session`, {
          credentials: "include",
        });
        const sessionData = await sessionRes.json();

        if (!sessionData.user) {
          window.location.href = "/login?redirect=/messages";
          return;
        }

        await loadConversations({ showSkeleton: true });
      } catch (err) {
        console.error("Auth check failed:", err);
        window.location.href = "/login?redirect=/messages";
      }
    }

    async function loadConversations(options = {}) {
      if (conversationsRequestInFlight) return;
      conversationsRequestInFlight = true;
      setRefreshBusy(true);

      if (options.showSkeleton) {
        renderSkeleton();
      }

      try {
        const res = await fetch(`${API_BASE}/messages`, {
          credentials: "include",
        });
        const data = await res.json().catch(() => ({}));

        if (res.status === 401) {
          window.location.href = "/login?redirect=/messages";
          return;
        }

        if (res.status === 403) {
          renderError(copy.centerForbidden, false);
          return;
        }

        if (data.success && Array.isArray(data.data) && data.data.length > 0) {
          renderList(data.data);
        } else {
          renderEmpty();
        }
      } catch (err) {
        renderError(copy.loadFailed, true);
      } finally {
        conversationsRequestInFlight = false;
        setRefreshBusy(false);
      }
    }

    function setRefreshBusy(isBusy) {
      if (refreshBtn) {
        refreshBtn.disabled = isBusy;
        refreshBtn.setAttribute("aria-busy", isBusy ? "true" : "false");
      }
      refreshIcon?.classList.toggle("animate-spin", isBusy);
    }

    function renderSkeleton() {
      if (!messageListEl) return;
      messageListEl.setAttribute("aria-busy", "true");
      messageListEl.replaceChildren();

      const wrapper = document.createElement("div");
      wrapper.className = "divide-y divide-border/70";
      wrapper.setAttribute("role", "status");
      wrapper.setAttribute("aria-label", copy.loadingConversations);

      for (let i = 0; i < 4; i += 1) {
        const row = document.createElement("div");
        row.className = "flex items-center gap-3 px-4 py-3.5 sm:px-5";

        const avatar = document.createElement("div");
        avatar.className = "h-12 w-12 shrink-0 animate-pulse rounded-full bg-muted";

        const content = document.createElement("div");
        content.className = "min-w-0 flex-1 space-y-2";

        const title = document.createElement("div");
        title.className = "h-3.5 w-1/3 animate-pulse rounded bg-muted";
        const text = document.createElement("div");
        text.className = "h-3 w-2/3 animate-pulse rounded bg-muted";

        content.appendChild(title);
        content.appendChild(text);
        row.appendChild(avatar);
        row.appendChild(content);
        wrapper.appendChild(row);
      }

      const srText = document.createElement("span");
      srText.className = "sr-only";
      srText.textContent = copy.loading;
      wrapper.appendChild(srText);
      messageListEl.appendChild(wrapper);
    }

    function renderList(conversations) {
      if (!messageListEl) return;

      messageListEl.removeAttribute("aria-busy");
      messageListEl.replaceChildren();

      conversations.forEach((conv) => {
        const otherUser = conv.otherUser;
        const displayName = getDisplayName(otherUser);
        const time = conv.lastMessageAt ? formatTime(conv.lastMessageAt) : "";
        const unreadCount = Number(conv.unreadCount) || 0;

        const link = document.createElement("a");
        link.href = `/messages/${encodeURIComponent(String(conv.id))}`;
        link.setAttribute("role", "listitem");
        link.setAttribute("aria-label", `${copy.openConversation}: ${displayName}`);
        link.className = "block transition-colors hover:bg-muted/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring";

        const container = document.createElement("div");
        container.className = "flex min-h-[76px] items-center gap-3 px-4 py-3.5 sm:px-5";

        container.appendChild(createAvatar(otherUser, "h-12 w-12 text-sm"));

        const contentDiv = document.createElement("div");
        contentDiv.className = "min-w-0 flex-1";

        const headerDiv = document.createElement("div");
        headerDiv.className = "flex items-baseline gap-2";

        const nameEl = document.createElement("h2");
        nameEl.className = "min-w-0 flex-1 truncate text-sm font-semibold text-foreground";
        nameEl.textContent = displayName;
        headerDiv.appendChild(nameEl);

        if (time) {
          const timeEl = document.createElement("time");
          timeEl.className = "shrink-0 text-xs text-muted-foreground";
          timeEl.textContent = time;
          headerDiv.appendChild(timeEl);
        }

        const footerDiv = document.createElement("div");
        footerDiv.className = "mt-1 flex items-center gap-2";

        const messageEl = document.createElement("p");
        messageEl.className = "min-w-0 flex-1 truncate text-sm text-muted-foreground";
        messageEl.textContent = conv.lastMessageContent || copy.noMessages;
        footerDiv.appendChild(messageEl);

        if (unreadCount > 0) {
          const badge = document.createElement("span");
          badge.className = "inline-flex h-5 min-w-5 shrink-0 items-center justify-center rounded-full bg-destructive px-1.5 text-2xs font-semibold leading-none text-white dark:text-neutral-900";
          badge.setAttribute("aria-label", `${unreadCount} ${copy.unreadMessages}`);
          badge.textContent = unreadCount > 99 ? "99+" : String(unreadCount);
          footerDiv.appendChild(badge);
        }

        contentDiv.appendChild(headerDiv);
        contentDiv.appendChild(footerDiv);
        container.appendChild(contentDiv);
        link.appendChild(container);
        messageListEl.appendChild(link);
      });
    }

    function renderEmpty() {
      if (!messageListEl) return;
      messageListEl.removeAttribute("aria-busy");
      messageListEl.replaceChildren();

      const container = document.createElement("div");
      container.className = "flex min-h-[22rem] flex-col items-center justify-center px-6 text-center";
      container.setAttribute("role", "status");

      const icon = document.createElement("div");
      icon.className = "mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-muted text-muted-foreground";
      const svg = document.createElementNS("http://www.w3.org/2000/svg", "svg");
      svg.setAttribute("fill", "none");
      svg.setAttribute("stroke", "currentColor");
      svg.setAttribute("viewBox", "0 0 24 24");
      svg.setAttribute("class", "h-7 w-7");
      svg.setAttribute("aria-hidden", "true");
      const path = document.createElementNS("http://www.w3.org/2000/svg", "path");
      path.setAttribute("stroke-linecap", "round");
      path.setAttribute("stroke-linejoin", "round");
      path.setAttribute("stroke-width", "1.7");
      path.setAttribute("d", "M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z");
      svg.appendChild(path);
      icon.appendChild(svg);

      const title = document.createElement("h2");
      title.className = "text-base font-semibold text-foreground";
      title.textContent = copy.emptyTitle;

      const desc = document.createElement("p");
      desc.className = "mt-2 max-w-xs text-sm leading-6 text-muted-foreground";
      desc.textContent = copy.emptyDescription;

      const link = document.createElement("a");
      link.href = "/";
      link.className = "mt-5 inline-flex h-10 items-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background";
      link.textContent = copy.discover;

      container.appendChild(icon);
      container.appendChild(title);
      container.appendChild(desc);
      container.appendChild(link);
      messageListEl.appendChild(container);
    }

    function renderError(message = copy.loadFailed, canRetry = true) {
      if (!messageListEl) return;
      messageListEl.removeAttribute("aria-busy");
      messageListEl.replaceChildren();

      const container = document.createElement("div");
      container.className = "flex min-h-[22rem] flex-col items-center justify-center px-6 text-center";
      container.setAttribute("role", "alert");

      const text = document.createElement("p");
      text.className = "max-w-sm text-sm leading-6 text-destructive";
      text.textContent = message;
      container.appendChild(text);

      if (canRetry) {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "mt-5 inline-flex h-10 items-center rounded-md border border-border bg-background px-4 text-sm font-medium text-foreground transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background";
        button.textContent = copy.retry;
        button.addEventListener("click", () => loadConversations({ showSkeleton: true }));
        container.appendChild(button);
      }

      messageListEl.appendChild(container);
    }

    function createAvatar(user, sizeClass) {
      const avatar = document.createElement("div");
      avatar.className = `${sizeClass} flex shrink-0 items-center justify-center overflow-hidden rounded-full bg-muted font-semibold text-muted-foreground ring-1 ring-border/70`;
      avatar.setAttribute("aria-hidden", "true");

      const imgUrl = user?.image ? String(user.image) : "";
      if (imgUrl.startsWith("http://") || imgUrl.startsWith("https://") || imgUrl.startsWith("/")) {
        const img = document.createElement("img");
        img.src = imgUrl;
        img.alt = "";
        img.loading = "lazy";
        img.className = "h-full w-full object-cover";
        avatar.appendChild(img);
        return avatar;
      }

      const fallback = document.createElement("span");
      fallback.textContent = getDisplayName(user).trim().charAt(0) || "?";
      avatar.appendChild(fallback);
      return avatar;
    }

    function getDisplayName(user) {
      return user?.nickname || user?.name || copy.unknownUser;
    }

    function formatTime(timestamp) {
      if (!timestamp) return "";
      const date = new Date(timestamp);
      if (Number.isNaN(date.getTime())) return "";

      const now = new Date();
      const isToday = date.toDateString() === now.toDateString();
      const yesterday = new Date(now);
      yesterday.setDate(yesterday.getDate() - 1);

      if (isToday) {
        return date.toLocaleTimeString(dateLocale, { hour: "2-digit", minute: "2-digit" });
      }
      if (date.toDateString() === yesterday.toDateString()) {
        return copy.yesterday;
      }
      return date.toLocaleDateString(dateLocale, { month: "short", day: "numeric" });
    }

    init();

    refreshBtn?.addEventListener("click", () => loadConversations());
    startPolling();

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        stopPolling();
      } else {
        loadConversations();
        startPolling();
      }
    });
  </script>
</Layout>
