---
/**
 * 消息中心页
 */
import Layout from "../../layouts/Layout.astro";
import { declareI18nNs } from "../../middleware";
import { DEFAULT_LOCALE, SUPPORTED_LOCALES, getSSRT, type Locale } from "../../i18n";
import { loadLocaleData } from "../../i18n/ssr-loader.server";

declareI18nNs(Astro.locals, ["messages", "common"]);

const localsLocale = (Astro.locals as any)?.locale as Locale | undefined;
const cookieLocale = Astro.cookies.get("gomate_locale")?.value as Locale | undefined;
const resolvedLocale = localsLocale || cookieLocale;
const locale: Locale = (resolvedLocale && SUPPORTED_LOCALES.includes(resolvedLocale))
  ? resolvedLocale
  : DEFAULT_LOCALE;
const loadedData = await loadLocaleData(["messages"], locale, Astro.url.origin);
const ssr = getSSRT(locale, { [locale]: loadedData } as Record<Locale, Record<string, Record<string, unknown>>>);
const dateLocale = locale === "zh-CN" ? "zh-CN" : locale === "ja" ? "ja-JP" : "en-US";
const apiBase = import.meta.env.PUBLIC_API_URL || "http://localhost:8799";
const copy = {
  centerTitle: ssr.t("messages.centerTitle"),
  loading: ssr.t("messages.loading"),
  emptyTitle: ssr.t("messages.emptyTitle"),
  emptyDescription: ssr.t("messages.emptyDescription"),
  discover: ssr.t("messages.discover"),
  unknownUser: ssr.t("messages.unknownUser"),
  noMessages: ssr.t("messages.noMessages"),
  retry: ssr.t("messages.retry"),
  loadFailed: ssr.t("messages.loadFailed"),
  centerForbidden: ssr.t("messages.centerForbidden"),
  yesterday: ssr.t("messages.yesterday"),
};
---

<Layout title="消息中心 - GoMate" showNavbar={true} showFooter={false}>
  <div class="min-h-screen bg-gray-50 dark:bg-gray-900">
    <div class="max-w-2xl mx-auto">
      {/* Header */}
      <div class="sticky top-0 z-10 bg-white dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700 px-4 py-4">
        <div class="flex items-center justify-between">
          <h1 class="text-lg font-semibold text-gray-900 dark:text-white">
            {copy.centerTitle}
          </h1>
          <button
            id="refreshBtn"
            class="p-2 text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 rounded-full hover:bg-gray-100 dark:hover:bg-gray-700"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
            </svg>
          </button>
        </div>
      </div>

      {/* Message List */}
      <div id="messageList" class="bg-white dark:bg-gray-800 min-h-[calc(100vh-140px)]">
        <div class="p-4 text-center text-gray-500">
          {copy.loading}
        </div>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ API_BASE: apiBase, copy, dateLocale }}>
    const messageListEl = document.getElementById("messageList");
    const refreshBtn = document.getElementById("refreshBtn");

    // Check auth and load conversations
    async function init() {
      try {
        // Check session
        const sessionRes = await fetch(`${API_BASE}/auth/get-session`, {
          credentials: "include",
        });
        const sessionData = await sessionRes.json();

        if (!sessionData.user) {
          window.location.href = "/login?redirect=/messages";
          return;
        }

        await loadConversations();
      } catch (err) {
        console.error("Auth check failed:", err);
        window.location.href = "/login?redirect=/messages";
      }
    }

    async function loadConversations() {
      try {
        const res = await fetch(`${API_BASE}/messages`, {
          credentials: "include",
        });
        const data = await res.json();

        if (res.status === 401) {
          window.location.href = "/login?redirect=/messages";
          return;
        }

        if (res.status === 403) {
          renderError(copy.centerForbidden);
          return;
        }

        if (data.success && data.data?.length > 0) {
          renderList(data.data);
        } else {
          renderEmpty();
        }
      } catch (err) {
        renderError(copy.loadFailed);
      }
    }

    function renderList(conversations) {
      if (!messageListEl) return;

      // Clear and rebuild using DOM API to avoid XSS
      messageListEl.innerHTML = "";

      conversations.forEach((conv) => {
        const otherUser = conv.otherUser;
        const time = conv.lastMessageAt
          ? formatTime(conv.lastMessageAt)
          : "";

        // Create link element
        const link = document.createElement("a");
        link.href = `/messages/${encodeURIComponent(String(conv.id))}`;
        link.className = "block hover:bg-gray-50 dark:hover:bg-gray-800/50 transition-colors";

        // Create container
        const container = document.createElement("div");
        container.className = "flex items-start gap-3 p-4 border-b border-gray-100 dark:border-gray-800";

        // Build avatar
        const avatarDiv = document.createElement("div");
        avatarDiv.className = "flex-shrink-0";
        if (otherUser?.image) {
          const imgUrl = String(otherUser.image);
          if (imgUrl.startsWith("http://") || imgUrl.startsWith("https://") || imgUrl.startsWith("/")) {
            const img = document.createElement("img");
            img.src = imgUrl;
            img.className = "w-12 h-12 rounded-full object-cover";
            avatarDiv.appendChild(img);
          } else {
            const fallback = document.createElement("div");
            fallback.className = "w-12 h-12 rounded-full bg-gray-200 dark:bg-gray-700 flex items-center justify-center";
            const span = document.createElement("span");
            span.className = "text-lg text-gray-500";
            span.textContent = otherUser?.name?.[0] || "?";
            fallback.appendChild(span);
            avatarDiv.appendChild(fallback);
          }
        } else {
          const fallback = document.createElement("div");
          fallback.className = "w-12 h-12 rounded-full bg-gray-200 dark:bg-gray-700 flex items-center justify-center";
          const span = document.createElement("span");
          span.className = "text-lg text-gray-500";
          span.textContent = otherUser?.name?.[0] || "?";
          fallback.appendChild(span);
          avatarDiv.appendChild(fallback);
        }
        container.appendChild(avatarDiv);

        // Build content
        const contentDiv = document.createElement("div");
        contentDiv.className = "flex-1 min-w-0";

        const headerDiv = document.createElement("div");
        headerDiv.className = "flex items-center justify-between mb-1";

        const nameEl = document.createElement("h4");
        nameEl.className = "text-sm font-medium text-gray-900 dark:text-white truncate";
        nameEl.textContent = otherUser?.nickname || otherUser?.name || copy.unknownUser;
        headerDiv.appendChild(nameEl);

        const timeEl = document.createElement("span");
        timeEl.className = "text-xs text-gray-400";
        timeEl.textContent = time;
        headerDiv.appendChild(timeEl);

        contentDiv.appendChild(headerDiv);

        const messageEl = document.createElement("p");
        messageEl.className = "text-sm text-gray-500 dark:text-gray-400 truncate";
        messageEl.textContent = conv.lastMessageContent || copy.noMessages;
        contentDiv.appendChild(messageEl);

        container.appendChild(contentDiv);

        // Unread count badge
        if (conv.unreadCount > 0) {
          const badgeDiv = document.createElement("div");
          badgeDiv.className = "flex-shrink-0";
          const badge = document.createElement("span");
          badge.className = "inline-flex items-center justify-center w-5 h-5 text-xs font-medium text-white bg-red-500 rounded-full";
          badge.textContent = conv.unreadCount > 99 ? "99+" : String(conv.unreadCount);
          badgeDiv.appendChild(badge);
          container.appendChild(badgeDiv);
        }

        link.appendChild(container);
        messageListEl.appendChild(link);
      });
    }

    function renderEmpty() {
      if (!messageListEl) return;
      messageListEl.innerHTML = "";
      const container = document.createElement("div");
      container.className = "flex flex-col items-center justify-center h-64 text-center p-4";
      const icon = document.createElement("div");
      icon.className = "w-16 h-16 mb-4 text-gray-300";
      icon.innerHTML = `
        <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" class="w-full h-full">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
        </svg>
      `;
      const title = document.createElement("h3");
      title.className = "text-lg font-medium text-gray-900 dark:text-white mb-2";
      title.textContent = copy.emptyTitle;
      const desc = document.createElement("p");
      desc.className = "text-sm text-gray-500 dark:text-gray-400";
      desc.textContent = copy.emptyDescription;
      const link = document.createElement("a");
      link.href = "/";
      link.className = "mt-4 px-4 py-2 bg-blue-500 text-white rounded-lg text-sm font-medium hover:bg-blue-600";
      link.textContent = copy.discover;
      container.appendChild(icon);
      container.appendChild(title);
      container.appendChild(desc);
      container.appendChild(link);
      messageListEl.appendChild(container);
    }

    function renderError(message = copy.loadFailed) {
      if (!messageListEl) return;
      messageListEl.innerHTML = "";
      const container = document.createElement("div");
      container.className = "flex flex-col items-center justify-center h-64 text-center p-4";
      const text = document.createElement("p");
      text.className = "text-gray-500";
      text.textContent = message;
      const button = document.createElement("button");
      button.type = "button";
      button.className = "mt-4 px-4 py-2 bg-gray-100 dark:bg-gray-800 rounded-lg text-sm";
      button.textContent = copy.retry;
      button.addEventListener("click", () => location.reload());
      container.appendChild(text);
      container.appendChild(button);
      messageListEl.appendChild(container);
    }

    function formatTime(timestamp) {
      if (!timestamp) return "";
      const date = new Date(timestamp);
      const now = new Date();
      const isToday = date.toDateString() === now.toDateString();
      const yesterday = new Date(now);
      yesterday.setDate(yesterday.getDate() - 1);

      if (isToday) {
        return date.toLocaleTimeString(dateLocale, { hour: "2-digit", minute: "2-digit" });
      } else if (date.toDateString() === yesterday.toDateString()) {
        return copy.yesterday;
      } else {
        return date.toLocaleDateString(dateLocale, { month: "short", day: "numeric" });
      }
    }

    // Load on mount
    init();

    // Refresh button
    refreshBtn?.addEventListener("click", loadConversations);

    // Polling (30s)
    setInterval(loadConversations, 30000);
  </script>
</Layout>
