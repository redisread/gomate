---
/**
 * 聊天详情页
 */
import Layout from "../../layouts/Layout.astro";
import { declareI18nNs } from "../../middleware";
import { DEFAULT_LOCALE, SUPPORTED_LOCALES, getSSRT, type Locale } from "../../i18n";
import { loadLocaleData } from "../../i18n/ssr-loader.server";

declareI18nNs(Astro.locals, ["messages", "common"]);

const localsLocale = (Astro.locals as any)?.locale as Locale | undefined;
const cookieLocale = Astro.cookies.get("gomate_locale")?.value as Locale | undefined;
const resolvedLocale = localsLocale || cookieLocale;
const locale: Locale = (resolvedLocale && SUPPORTED_LOCALES.includes(resolvedLocale))
  ? resolvedLocale
  : DEFAULT_LOCALE;
const loadedData = await loadLocaleData(["messages"], locale, Astro.url.origin);
const ssr = getSSRT(locale, { [locale]: loadedData } as Record<Locale, Record<string, Record<string, unknown>>>);
const dateLocale = locale === "zh-CN" ? "zh-CN" : "en-US";
const apiBase = "/api";
const copy = {
  loading: ssr.t("messages.loading"),
  unknownUser: ssr.t("messages.unknownUser"),
  noMessagesPrompt: ssr.t("messages.noMessagesPrompt"),
  inputPlaceholder: ssr.t("messages.inputPlaceholder"),
  loadFailed: ssr.t("messages.loadFailed"),
  forbidden: ssr.t("messages.forbidden"),
  sendFailed: ssr.t("messages.sendFailed"),
  read: ssr.t("messages.read"),
  today: ssr.t("messages.today"),
  yesterday: ssr.t("messages.yesterday"),
  backToMessages: ssr.t("messages.backToMessages"),
  messageList: ssr.t("messages.messageList"),
  messageInputLabel: ssr.t("messages.messageInputLabel"),
  sendMessage: ssr.t("messages.sendMessage"),
  sending: ssr.t("messages.sending"),
  privateConversation: ssr.t("messages.privateConversation"),
  loadEarlier: ssr.t("messages.loadEarlier"),
  loadingEarlier: ssr.t("messages.loadingEarlier"),
  loadEarlierFailed: ssr.t("messages.loadEarlierFailed"),
};
const { id } = Astro.params;
const clientConfig = JSON.stringify({
  conversationId: id ?? "",
  apiBase,
  dateLocale,
  copy,
});
---

<Layout title="聊天 - GoMate" showNavbar={false} showFooter={false}>
  <div
    id="messageChatPage"
    data-config={clientConfig}
    class="fixed inset-0 flex flex-col bg-background text-foreground"
  >
    <header class="shrink-0 border-b border-border bg-background/95 px-3 py-2.5 backdrop-blur">
      <div class="mx-auto flex max-w-2xl items-center gap-3">
        <a
          href="/messages"
          aria-label={copy.backToMessages}
          title={copy.backToMessages}
          class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-full text-muted-foreground transition-colors hover:bg-muted hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
        >
          <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </a>

        <div id="headerAvatar" class="hidden"></div>

        <div id="headerInfo" class="min-w-0 flex-1">
          <h1 class="truncate text-base font-semibold leading-tight text-foreground">{copy.loading}</h1>
          <p id="headerMeta" class="mt-0.5 hidden text-xs text-muted-foreground"></p>
        </div>
      </div>
    </header>

    <main id="chatContainer" class="flex-1 overflow-y-auto px-3 py-4 sm:px-4">
      <div id="historyControls" hidden class="mx-auto hidden max-w-2xl pb-4 text-center">
        <button
          id="loadEarlierBtn"
          type="button"
          aria-busy="false"
          class="inline-flex min-h-10 items-center justify-center rounded-full border border-border bg-card px-4 py-2 text-sm font-medium text-foreground transition-colors hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background disabled:cursor-not-allowed disabled:opacity-60"
        >
          {copy.loadEarlier}
        </button>
        <p
          id="historyError"
          role="alert"
          hidden
          class="mt-2 hidden text-sm leading-5 text-destructive"
        ></p>
      </div>

      <div
        id="messageList"
        role="log"
        aria-live="polite"
        aria-relevant="additions text"
        aria-label={copy.messageList}
      >
        <div role="status" aria-label={copy.loading} class="mx-auto flex max-w-2xl flex-col gap-4">
          <div class="flex justify-start gap-2">
            <div class="h-8 w-8 shrink-0 animate-pulse rounded-full bg-muted"></div>
            <div class="h-10 w-44 animate-pulse rounded-2xl rounded-bl-md bg-muted"></div>
          </div>
          <div class="flex justify-end">
            <div class="h-10 w-52 animate-pulse rounded-2xl rounded-br-md bg-muted"></div>
          </div>
          <span class="sr-only">{copy.loading}</span>
        </div>
      </div>
    </main>

    <form
      id="messageForm"
      class="shrink-0 border-t border-border bg-background/95 px-3 py-3 pb-[calc(0.75rem+env(safe-area-inset-bottom))] backdrop-blur sm:px-4"
    >
      <div class="mx-auto max-w-2xl space-y-2">
        <p id="chatError" role="alert" hidden class="hidden text-sm leading-5 text-destructive"></p>
        <div class="flex items-end gap-2">
          <label for="messageInput" class="sr-only">{copy.messageInputLabel}</label>
          <input
            id="messageInput"
            type="text"
            maxlength="1000"
            autocomplete="off"
            placeholder={copy.inputPlaceholder}
            class="h-11 min-w-0 flex-1 rounded-full border border-input bg-card px-4 text-sm text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-ring disabled:cursor-not-allowed disabled:opacity-60"
          />
          <button
            id="sendBtn"
            type="submit"
            disabled
            aria-label={copy.sendMessage}
            title={copy.sendMessage}
            class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-primary text-primary-foreground transition-colors hover:bg-primary/90 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background disabled:cursor-not-allowed disabled:opacity-50"
          >
            <span id="sendText" class="sr-only">{copy.sendMessage}</span>
            <svg id="sendIcon" class="h-4.5 w-4.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h13m0 0-5-5m5 5-5 5" />
            </svg>
            <svg id="sendSpinner" class="hidden h-4.5 w-4.5 animate-spin" fill="none" viewBox="0 0 24 24" aria-hidden="true">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
            </svg>
          </button>
        </div>
      </div>
    </form>
  </div>

  <script>
    import { initializeMessageChatPage } from "../../components/features/messages/chat-page-client";

    void initializeMessageChatPage();
  </script>
</Layout>
