---
/**
 * 聊天详情页
 */
import Layout from "../../layouts/Layout.astro";
import { declareI18nNs } from "../../middleware";

declareI18nNs(Astro.locals, ["messages", "common"]);

const { id } = Astro.params;
---

<Layout title="聊天 - GoMate" showNavbar={false} showFooter={false}>
  <div class="fixed inset-0 bg-white dark:bg-gray-900">
    {/* Header */}
    <div class="sticky top-0 z-10 bg-white dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700 px-4 py-3">
      <div class="flex items-center gap-3">
        <a
          href="/messages"
          class="p-2 -ml-2 text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 rounded-full hover:bg-gray-100 dark:hover:bg-gray-700"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </a>
        <div id="headerInfo" class="flex-1">
          <h1 class="text-base font-semibold text-gray-900 dark:text-white">加载中...</h1>
        </div>
      </div>
    </div>

    {/* Chat Messages */}
    <div id="chatContainer" class="h-[calc(100vh-120px)] overflow-y-auto p-4 space-y-4">
      <div class="text-center text-gray-500">加载中...</div>
    </div>

    {/* Input */}
    <div class="fixed bottom-0 left-0 right-0 bg-white dark:bg-gray-800 border-t border-gray-200 dark:border-gray-700 p-4">
      <div class="max-w-2xl mx-auto flex items-center gap-2">
        <input
          id="messageInput"
          type="text"
          placeholder="输入消息..."
          class="flex-1 px-4 py-2 bg-gray-100 dark:bg-gray-700 rounded-full text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 dark:text-white"
        />
        <button
          id="sendBtn"
          class="px-4 py-2 bg-blue-500 text-white rounded-full text-sm font-medium disabled:opacity-50 hover:bg-blue-600 transition-colors"
        >
          发送
        </button>
      </div>
    </div>
  </div>

  <script define:vars={{ conversationId: id }}>
    const API_BASE = import.meta.env.PUBLIC_API_URL || "http://localhost:8799";
    const chatContainer = document.getElementById("chatContainer");
    const messageInput = document.getElementById("messageInput");
    const sendBtn = document.getElementById("sendBtn");
    const headerInfo = document.getElementById("headerInfo");

    let messages = [];
    let currentUserId = null;
    let otherUser = null;

    // Initialize
    async function init() {
      try {
        // Check session
        const sessionRes = await fetch(`${API_BASE}/auth/session`, {
          credentials: "include",
        });
        const sessionData = await sessionRes.json();

        if (!sessionData.user) {
          window.location.href = "/login?redirect=/messages";
          return;
        }

        currentUserId = sessionData.user.id;
        await loadMessages();
      } catch (err) {
        console.error("Auth check failed:", err);
        window.location.href = "/login?redirect=/messages";
      }
    }

    async function loadMessages() {
      try {
        const res = await fetch(`${API_BASE}/messages/${conversationId}?limit=50`, {
          credentials: "include",
        });

        if (res.status === 401) {
          window.location.href = "/login?redirect=/messages";
          return;
        }

        const data = await res.json();

        if (data.success) {
          messages = data.data || [];
          // Get other user info
          if (messages.length > 0) {
            const firstMsg = messages[0];
            otherUser = firstMsg.senderId === currentUserId
              ? messages.find(m => m.senderId !== currentUserId)?.sender
              : firstMsg.sender;
            updateHeader();
          }
          renderMessages();
          scrollToBottom();
        }
      } catch (err) {
        chatContainer.innerHTML = `<div class="text-center text-red-500">加载失败</div>`;
      }
    }

    function updateHeader() {
      if (!otherUser) return;
      headerInfo.innerHTML = `
        <h1 class="text-base font-semibold text-gray-900 dark:text-white">
          ${otherUser.nickname || otherUser.name || "未知用户"}
        </h1>
      `;
    }

    function renderMessages() {
      if (messages.length === 0) {
        chatContainer.innerHTML = `<div class="text-center text-gray-500">暂无消息，发送一条吧</div>`;
        return;
      }

      // Group by date
      const grouped = groupByDate(messages);

      chatContainer.innerHTML = grouped.map((group) => `
        <div class="space-y-3">
          <div class="flex items-center justify-center">
            <span class="text-xs text-gray-400 bg-gray-100 dark:bg-gray-800 px-3 py-1 rounded-full">
              ${formatDate(group.date)}
            </span>
          </div>
          ${group.messages.map(renderMessage).join("")}
        </div>
      `).join("");
    }

    function renderMessage(msg) {
      const isOwn = msg.senderId === currentUserId;
      const sender = msg.sender || {};
      const time = msg.createdAt
        ? new Date(msg.createdAt).toLocaleTimeString("zh-CN", { hour: "2-digit", minute: "2-digit" })
        : "";

      if (isOwn) {
        return `
          <div class="flex justify-end">
            <div class="max-w-[70%]">
              <div class="px-4 py-2 bg-blue-500 text-white rounded-2xl rounded-br-lg text-sm">
                ${escapeHtml(msg.content)}
              </div>
              <div class="text-right mt-1 text-xs text-gray-400">
                ${time}${msg.isRead ? " · 已读" : ""}
              </div>
            </div>
          </div>
        `;
      } else {
        const avatar = sender.image
          ? `<img src="${sender.image}" class="w-8 h-8 rounded-full object-cover" />`
          : `<div class="w-8 h-8 rounded-full bg-gray-200 dark:bg-gray-700 flex items-center justify-center"><span class="text-sm text-gray-500">${sender.name?.[0] || "?"}</span></div>`;

        return `
          <div class="flex justify-start gap-2">
            <div class="flex-shrink-0">${avatar}</div>
            <div class="max-w-[70%]">
              <div class="text-xs text-gray-500 mb-1">${sender.nickname || sender.name}</div>
              <div class="px-4 py-2 bg-gray-100 dark:bg-gray-800 text-gray-900 dark:text-white rounded-2xl rounded-bl-lg text-sm">
                ${escapeHtml(msg.content)}
              </div>
              <div class="mt-1 text-xs text-gray-400">${time}</div>
            </div>
          </div>
        `;
      }
    }

    function groupByDate(msgs) {
      const groups = [];
      msgs.forEach((msg) => {
        const date = msg.createdAt ? new Date(msg.createdAt).toDateString() : "";
        const existing = groups.find((g) => g.date === date);
        if (existing) {
          existing.messages.push(msg);
        } else {
          groups.push({ date, messages: [msg] });
        }
      });
      return groups;
    }

    function formatDate(dateStr) {
      const date = new Date(dateStr);
      const today = new Date();
      const yesterday = new Date(today);
      yesterday.setDate(yesterday.getDate() - 1);

      if (date.toDateString() === today.toDateString()) return "今天";
      if (date.toDateString() === yesterday.toDateString()) return "昨天";
      return date.toLocaleDateString("zh-CN", { year: "numeric", month: "long", day: "numeric" });
    }

    function escapeHtml(text) {
      const div = document.createElement("div");
      div.textContent = text;
      return div.innerHTML;
    }

    function scrollToBottom() {
      chatContainer.scrollTop = chatContainer.scrollHeight;
    }

    async function sendMessage() {
      const content = messageInput.value.trim();
      if (!content) return;

      sendBtn.disabled = true;

      try {
        const res = await fetch(`${API_BASE}/messages/${conversationId}`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          credentials: "include",
          body: JSON.stringify({ content }),
        });
        const data = await res.json();

        if (data.success) {
          messageInput.value = "";
          // Optimistically add message
          messages.push({
            id: data.data.id,
            senderId: currentUserId,
            content,
            isRead: false,
            createdAt: Date.now(),
          });
          renderMessages();
          scrollToBottom();
        }
      } catch (err) {
        alert("发送失败，请重试");
      } finally {
        sendBtn.disabled = false;
      }
    }

    sendBtn?.addEventListener("click", sendMessage);
    messageInput?.addEventListener("keydown", (e) => {
      if (e.key === "Enter" && !e.shiftKey) {
        e.preventDefault();
        sendMessage();
      }
    });

    // Polling (5s)
    setInterval(loadMessages, 5000);

    init();
  </script>
</Layout>
