---
/**
 * 聊天详情页
 */
import Layout from "../../layouts/Layout.astro";
import { declareI18nNs } from "../../middleware";
import { DEFAULT_LOCALE, SUPPORTED_LOCALES, getSSRT, type Locale } from "../../i18n";
import { loadLocaleData } from "../../i18n/ssr-loader.server";

declareI18nNs(Astro.locals, ["messages", "common"]);

const localsLocale = (Astro.locals as any)?.locale as Locale | undefined;
const cookieLocale = Astro.cookies.get("gomate_locale")?.value as Locale | undefined;
const resolvedLocale = localsLocale || cookieLocale;
const locale: Locale = (resolvedLocale && SUPPORTED_LOCALES.includes(resolvedLocale))
  ? resolvedLocale
  : DEFAULT_LOCALE;
const loadedData = await loadLocaleData(["messages"], locale, Astro.url.origin);
const ssr = getSSRT(locale, { [locale]: loadedData } as Record<Locale, Record<string, Record<string, unknown>>>);
const dateLocale = locale === "zh-CN" ? "zh-CN" : locale === "ja" ? "ja-JP" : "en-US";
const apiBase = import.meta.env.PUBLIC_API_URL || "http://localhost:8799";
const copy = {
  loading: ssr.t("messages.loading"),
  unknownUser: ssr.t("messages.unknownUser"),
  noMessagesPrompt: ssr.t("messages.noMessagesPrompt"),
  inputPlaceholder: ssr.t("messages.inputPlaceholder"),
  send: ssr.t("messages.send"),
  loadFailed: ssr.t("messages.loadFailed"),
  forbidden: ssr.t("messages.forbidden"),
  sendFailed: ssr.t("messages.sendFailed"),
  read: ssr.t("messages.read"),
  today: ssr.t("messages.today"),
  yesterday: ssr.t("messages.yesterday"),
};
const { id } = Astro.params;
---

<Layout title="聊天 - GoMate" showNavbar={false} showFooter={false}>
  <div class="fixed inset-0 bg-white dark:bg-gray-900">
    {/* Header */}
    <div class="sticky top-0 z-10 bg-white dark:bg-gray-800 border-b border-gray-200 dark:border-gray-700 px-4 py-3">
      <div class="flex items-center gap-3">
        <a
          href="/messages"
          class="p-2 -ml-2 text-gray-500 hover:text-gray-700 dark:text-gray-400 dark:hover:text-gray-200 rounded-full hover:bg-gray-100 dark:hover:bg-gray-700"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
          </svg>
        </a>
        <div id="headerInfo" class="flex-1">
          <h1 class="text-base font-semibold text-gray-900 dark:text-white">{copy.loading}</h1>
        </div>
      </div>
    </div>

    {/* Chat Messages */}
    <div id="chatContainer" class="h-[calc(100vh-120px)] overflow-y-auto p-4 space-y-4">
      <div class="text-center text-gray-500">{copy.loading}</div>
    </div>

    {/* Input */}
    <div class="fixed bottom-0 left-0 right-0 bg-white dark:bg-gray-800 border-t border-gray-200 dark:border-gray-700 p-4">
      <div class="max-w-2xl mx-auto space-y-2">
        <p id="chatError" class="hidden text-sm text-red-600"></p>
        <div class="flex items-center gap-2">
          <input
            id="messageInput"
            type="text"
            placeholder={copy.inputPlaceholder}
            class="flex-1 px-4 py-2 bg-gray-100 dark:bg-gray-700 rounded-full text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 dark:text-white disabled:opacity-60"
          />
          <button
            id="sendBtn"
            class="px-4 py-2 bg-blue-500 text-white rounded-full text-sm font-medium disabled:opacity-50 hover:bg-blue-600 transition-colors"
          >
            {copy.send}
          </button>
        </div>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ conversationId: id, API_BASE: apiBase, copy, dateLocale }}>
    const chatContainer = document.getElementById("chatContainer");
    const messageInput = document.getElementById("messageInput");
    const sendBtn = document.getElementById("sendBtn");
    const headerInfo = document.getElementById("headerInfo");
    const chatError = document.getElementById("chatError");

    let messages = [];
    let currentUserId = null;
    let otherUser = null;

    // Initialize
    async function init() {
      try {
        // Check session
        const sessionRes = await fetch(`${API_BASE}/auth/get-session`, {
          credentials: "include",
        });
        const sessionData = await sessionRes.json();

        if (!sessionData.user) {
          window.location.href = "/login?redirect=/messages";
          return;
        }

        currentUserId = sessionData.user.id;
        await loadMessages();
      } catch (err) {
        console.error("Auth check failed:", err);
        window.location.href = "/login?redirect=/messages";
      }
    }

    async function loadMessages() {
      try {
        const res = await fetch(`${API_BASE}/messages/${conversationId}?limit=50`, {
          credentials: "include",
        });

        if (res.status === 401) {
          window.location.href = "/login?redirect=/messages";
          return;
        }

        if (res.status === 403) {
          setComposerDisabled(true);
          renderStatusMessage(copy.forbidden, "text-center text-red-500");
          return;
        }

        const data = await res.json();

        if (data.success) {
          messages = data.data || [];
          if (data.conversation?.otherUser) {
            otherUser = data.conversation.otherUser;
            updateHeader();
          }
          // Get other user info
          if (!otherUser && messages.length > 0) {
            const firstMsg = messages[0];
            otherUser = firstMsg.senderId === currentUserId
              ? messages.find(m => m.senderId !== currentUserId)?.sender
              : firstMsg.sender;
            updateHeader();
          }
          renderMessages();
          scrollToBottom();
        } else {
          showChatError(getErrorMessage(data, copy.loadFailed));
        }
      } catch (err) {
        renderStatusMessage(copy.loadFailed, "text-center text-red-500");
      }
    }

    function renderStatusMessage(message, className = "text-center text-gray-500") {
      if (!chatContainer) return;
      chatContainer.innerHTML = "";
      const status = document.createElement("div");
      status.className = className;
      status.textContent = message;
      chatContainer.appendChild(status);
    }

    function setComposerDisabled(disabled) {
      if (messageInput) messageInput.disabled = disabled;
      if (sendBtn) sendBtn.disabled = disabled;
    }

    function showChatError(message) {
      if (!chatError) return;
      chatError.textContent = message;
      chatError.classList.remove("hidden");
    }

    function clearChatError() {
      if (!chatError) return;
      chatError.textContent = "";
      chatError.classList.add("hidden");
    }

    function getErrorMessage(data, fallback) {
      if (typeof data?.error === "string") return data.error;
      if (typeof data?.error?.message === "string") return data.error.message;
      if (typeof data?.message === "string") return data.message;
      return fallback;
    }

    function updateHeader() {
      if (!otherUser) return;
      // Use textContent to avoid XSS
      const h1 = headerInfo.querySelector("h1");
      if (h1) {
        h1.textContent = otherUser.nickname || otherUser.name || copy.unknownUser;
      }
    }

    function renderMessages() {
      if (messages.length === 0) {
        renderStatusMessage(copy.noMessagesPrompt);
        return;
      }

      // Group by date
      const grouped = groupByDate(messages);

      // Build using DOM API to avoid XSS
      chatContainer.innerHTML = "";

      grouped.forEach((group) => {
        const groupDiv = document.createElement("div");
        groupDiv.className = "space-y-3";

        // Date header
        const dateDiv = document.createElement("div");
        dateDiv.className = "flex items-center justify-center";
        const dateSpan = document.createElement("span");
        dateSpan.className = "text-xs text-gray-400 bg-gray-100 dark:bg-gray-800 px-3 py-1 rounded-full";
        dateSpan.textContent = formatDate(group.date);
        dateDiv.appendChild(dateSpan);
        groupDiv.appendChild(dateDiv);

        // Messages
        group.messages.forEach((msg) => {
          const msgEl = renderMessageElement(msg);
          groupDiv.appendChild(msgEl);
        });

        chatContainer.appendChild(groupDiv);
      });
    }

    function renderMessageElement(msg) {
      const isOwn = msg.senderId === currentUserId;
      const sender = msg.sender || {};
      const time = msg.createdAt
        ? new Date(msg.createdAt).toLocaleTimeString(dateLocale, { hour: "2-digit", minute: "2-digit" })
        : "";

      const wrapper = document.createElement("div");

      if (isOwn) {
        wrapper.className = "flex justify-end";

        const container = document.createElement("div");
        container.className = "max-w-[70%]";

        const contentDiv = document.createElement("div");
        contentDiv.className = "px-4 py-2 bg-blue-500 text-white rounded-2xl rounded-br-lg text-sm";
        contentDiv.textContent = msg.content || "";
        container.appendChild(contentDiv);

        const metaDiv = document.createElement("div");
        metaDiv.className = "text-right mt-1 text-xs text-gray-400";
        metaDiv.textContent = time + (msg.isRead ? ` · ${copy.read}` : "");
        container.appendChild(metaDiv);

        wrapper.appendChild(container);
      } else {
        wrapper.className = "flex justify-start gap-2";

        // Build avatar safely
        const avatarDiv = document.createElement("div");
        avatarDiv.className = "flex-shrink-0";
        if (sender.image) {
          const imgUrl = String(sender.image);
          if (imgUrl.startsWith("http://") || imgUrl.startsWith("https://") || imgUrl.startsWith("/")) {
            const img = document.createElement("img");
            img.src = imgUrl;
            img.className = "w-8 h-8 rounded-full object-cover";
            avatarDiv.appendChild(img);
          } else {
            const fallback = document.createElement("div");
            fallback.className = "w-8 h-8 rounded-full bg-gray-200 dark:bg-gray-700 flex items-center justify-center";
            const span = document.createElement("span");
            span.className = "text-sm text-gray-500";
            span.textContent = sender.name?.[0] || "?";
            fallback.appendChild(span);
            avatarDiv.appendChild(fallback);
          }
        } else {
          const fallback = document.createElement("div");
          fallback.className = "w-8 h-8 rounded-full bg-gray-200 dark:bg-gray-700 flex items-center justify-center";
          const span = document.createElement("span");
          span.className = "text-sm text-gray-500";
          span.textContent = sender.name?.[0] || "?";
          fallback.appendChild(span);
          avatarDiv.appendChild(fallback);
        }
        wrapper.appendChild(avatarDiv);

        // Build content
        const container = document.createElement("div");
        container.className = "max-w-[70%]";

        const senderDiv = document.createElement("div");
        senderDiv.className = "text-xs text-gray-500 mb-1";
        senderDiv.textContent = sender.nickname || sender.name || "";
        container.appendChild(senderDiv);

        const contentDiv = document.createElement("div");
        contentDiv.className = "px-4 py-2 bg-gray-100 dark:bg-gray-800 text-gray-900 dark:text-white rounded-2xl rounded-bl-lg text-sm";
        contentDiv.textContent = msg.content || "";
        container.appendChild(contentDiv);

        const timeDiv = document.createElement("div");
        timeDiv.className = "mt-1 text-xs text-gray-400";
        timeDiv.textContent = time;
        container.appendChild(timeDiv);

        wrapper.appendChild(container);
      }

      return wrapper;
    }

    function groupByDate(msgs) {
      const groups = [];
      msgs.forEach((msg) => {
        const date = msg.createdAt ? new Date(msg.createdAt).toDateString() : "";
        const existing = groups.find((g) => g.date === date);
        if (existing) {
          existing.messages.push(msg);
        } else {
          groups.push({ date, messages: [msg] });
        }
      });
      return groups;
    }

    function formatDate(dateStr) {
      const date = new Date(dateStr);
      const today = new Date();
      const yesterday = new Date(today);
      yesterday.setDate(yesterday.getDate() - 1);

      if (date.toDateString() === today.toDateString()) return copy.today;
      if (date.toDateString() === yesterday.toDateString()) return copy.yesterday;
      return date.toLocaleDateString(dateLocale, { year: "numeric", month: "long", day: "numeric" });
    }

    function scrollToBottom() {
      chatContainer.scrollTop = chatContainer.scrollHeight;
    }

    async function sendMessage() {
      const content = messageInput.value.trim();
      if (!content) return;

      sendBtn.disabled = true;
      clearChatError();

      try {
        const res = await fetch(`${API_BASE}/messages/${conversationId}`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          credentials: "include",
          body: JSON.stringify({ content }),
        });
        const data = await res.json();

        if (!res.ok || !data.success) {
          showChatError(getErrorMessage(data, copy.sendFailed));
          return;
        }

        if (data.success) {
          messageInput.value = "";
          // Optimistically add message
          messages.push({
            id: data.data.id,
            senderId: currentUserId,
            content,
            isRead: false,
            createdAt: Date.now(),
          });
          renderMessages();
          scrollToBottom();
        }
      } catch (err) {
        showChatError(copy.sendFailed);
      } finally {
        sendBtn.disabled = false;
      }
    }

    sendBtn?.addEventListener("click", sendMessage);
    messageInput?.addEventListener("keydown", (e) => {
      if (e.key === "Enter" && !e.shiftKey) {
        e.preventDefault();
        sendMessage();
      }
    });

    // Polling (5s)
    setInterval(loadMessages, 5000);

    init();
  </script>
</Layout>
