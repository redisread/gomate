---
/**
 * 故事详情页 - 动态路由
 */
import Layout from "../../layouts/Layout.astro";
import { StoryDetail } from "../../components/features/discover-client";
import { declareI18nNs } from "../../middleware";
import { serverApiGet } from "../../lib/server-api";

declareI18nNs(Astro.locals, ["content", "common", "teams", "share", "favorites"]);

const { id } = Astro.params;

// 服务端获取故事数据，用于 SEO
const storyResponse = await serverApiGet<{
  success: boolean;
  data?: {
    title?: string | null;
    displayTitle?: string;
    summary?: string | null;
    images?: string[];
  };
}>(Astro.request, Astro.locals, `/stories/${id}`);
const storyData = storyResponse?.success ? storyResponse.data ?? null : null;

const title = storyData?.displayTitle || storyData?.title || "故事详情";

const description = storyData?.summary
  ? storyData.summary.slice(0, 160)
  : "发现精彩内容，分享户外故事";

const ogImage = storyData?.images?.[0];
---

<Layout
  title={title}
  description={description}
  ogImage={ogImage}
  showNavbar={true}
  showFooter={true}
>
  <StoryDetail storyId={id!} client:visible />
</Layout>
