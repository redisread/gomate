---
/**
 * 队伍列表页
 */
import Layout from "../../layouts/Layout.astro";
import { TeamsClient } from "../../components/features/teams-client";
import { declareI18nNs } from "../../middleware";
import { serverApiGet } from "../../lib/server-api";
import { getDateRangeByQuickType } from "../../lib/date-beijing";
import { parseTeamTagFilters } from "../../lib/team-filter-params";
import type { TeamsInitialData } from "../../components/features/teams/use-teams";
import type { ActivityType, RecruitmentStatus, Region, Team } from "../../lib/types";

declareI18nNs(Astro.locals, ["teams", "filter", "enums", "content"]); // task #158：TeamCard/FilterPanel 难度标签走 enums

const params = Astro.url.searchParams;
const searchQuery = (params.get("q") || "").slice(0, 120);
const selectedRegionId = (params.get("regionId") || "").slice(0, 64);
const activityTypeParam = params.get("activityType");
const selectedActivityType: ActivityType | "" = ["hiking", "explore", "leisure", "travel"].includes(activityTypeParam ?? "")
  ? activityTypeParam as ActivityType
  : "";
const recruitmentStatusParam = params.get("recruitmentStatus");
const selectedRecruitmentStatus: RecruitmentStatus | "" = recruitmentStatusParam === "all"
  ? ""
  : recruitmentStatusParam === "closed"
    ? "closed"
    : "open";
const listQuery = new URLSearchParams();
if (selectedRecruitmentStatus) listQuery.set("recruitmentStatus", selectedRecruitmentStatus);
listQuery.set("limit", "12");
if (searchQuery) listQuery.set("search", searchQuery);
const selectedTags = parseTeamTagFilters(params.get("tags"));
if (selectedActivityType) listQuery.set("activityType", selectedActivityType);
if (selectedRegionId) listQuery.set("regionId", selectedRegionId);
if (selectedTags.length) listQuery.set("tagIds", selectedTags.join(","));

const timeFilter = params.get("timeFilter");
const quickRange = timeFilter ? getDateRangeByQuickType(timeFilter) : null;
const startDate = quickRange?.start || params.get("startDate");
const endDate = quickRange?.end || params.get("endDate");
if (startDate) listQuery.set("startDateFrom", startDate);
if (endDate) listQuery.set("startDateTo", endDate);

const [teamsData, tagsData, regionsData] = await Promise.all([
  serverApiGet<{ success: boolean; teams: Team[]; total: number; nextCursor: string | null }>(Astro.request, Astro.locals, `/teams?${listQuery}`),
  serverApiGet<{ success: boolean; tags: { id: string; name: string }[] }>(Astro.request, Astro.locals, "/tags?limit=200"),
  serverApiGet<{ success: boolean; regions: Region[] }>(Astro.request, Astro.locals, "/regions?countryCode=CN&level=city&serviceEnabled=true"),
]);

const initialData = teamsData?.success
  ? {
      teams: teamsData.teams ?? [],
      pagination: {
        limit: 12,
        total: teamsData.total,
        nextCursor: teamsData.nextCursor,
      },
      availableTags: tagsData?.success ? tagsData.tags ?? [] : [],
      tagsComplete: Boolean(tagsData?.success),
      availableRegions: regionsData?.success ? regionsData.regions ?? [] : [],
      regionsComplete: Boolean(regionsData?.success),
      filters: {
        searchQuery,
        selectedActivityType,
        selectedRecruitmentStatus,
        selectedRegionId,
        startDate: startDate || "",
        endDate: endDate || "",
        selectedTags,
      },
    } satisfies TeamsInitialData
  : undefined;
---

<Layout title="探索队伍 - GoMate" showNavbar={false} showFooter={false}>
  <TeamsClient initialData={initialData} client:load />
</Layout>
