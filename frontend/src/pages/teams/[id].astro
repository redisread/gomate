---
/**
 * 队伍详情页 - Partiful 风格
 */
import Layout from "../../layouts/Layout.astro";
import { TeamDetailPartiful } from "../../components/features/team-detail-partiful";
import { declareI18nNs } from "../../middleware";

declareI18nNs(Astro.locals, ["teams", "content"]);

const { id } = Astro.params;
const ogImage = id ? `https://api.gomate.live/share-image/team/${id}` : undefined;
---

<Layout title="队伍详情 - GoMate" showNavbar={false} showFooter={false} ogImage={ogImage}>
  <TeamDetailPartiful teamId={id!} client:visible />
</Layout>
