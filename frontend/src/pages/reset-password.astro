---
/**
 * 重置密码页
 */
import Layout from "../layouts/Layout.astro";
import { ResetPasswordClient } from "../components/features/reset-password-client";
import { declareI18nNs } from "../middleware";

declareI18nNs(Astro.locals, ["auth", "content"]);
Astro.response.headers.set("Cache-Control", "no-store");
Astro.response.headers.set("Referrer-Policy", "no-referrer");
---

<Layout
  title="重置密码 - GoMate"
  showNavbar={false}
  showFooter={false}
>
  <ResetPasswordClient client:load />
</Layout>
