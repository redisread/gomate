---
import Layout from "@/layouts/Layout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { copy } from "@/lib/copy";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await post.render();

const categoryLabels = {
  product: "产品动态",
  story: "用户故事",
  guide: "徒步指南",
  activity: "活动回顾",
};

const categoryColors = {
  product: "#3B82F6",
  story: "#10B981",
  guide: "#F59E0B",
  activity: "#8B5CF6",
};

function formatDate(date: Date) {
  return date.toLocaleDateString("zh-CN", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}

function estimateReadTime(content: string) {
  const words = content.split(/\s+/).length;
  const minutes = Math.ceil(words / 200);
  return `${minutes} 分钟`;
}
---

<Layout title={post.data.title}>
  <div class="min-h-screen" style="background: #FDFAF6">
    <!-- Hero Section -->
    <header class="relative py-12 px-6 sm:px-8">
      <div class="max-w-3xl mx-auto">
        <!-- Back Button -->
        <a
          href="/blog"
          class="inline-flex items-center gap-2 mb-8 font-medium hover:underline"
          style="color: #D97706"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m15 18-6-6 6-6"/>
          </svg>
          返回博客
        </a>

        <!-- Category Badge -->
        <div class="mb-4">
          <span
            class="inline-block px-3 py-1 rounded-full text-sm font-medium"
            style={`background: rgba(${categoryColors[post.data.category].slice(1).match(/[0-9A-F]{2}/g).join(',')}, 0.1); color: ${categoryColors[post.data.category]}`}
          >
            {categoryLabels[post.data.category]}
          </span>
        </div>

        <!-- Title -->
        <h1 class="text-3xl sm:text-4xl font-bold mb-4" style="color: #2C1810">
          {post.data.title}
        </h1>

        <!-- Description -->
        <p class="text-lg mb-6" style="color: #8B6F5E">
          {post.data.description}
        </p>

        <!-- Meta Info -->
        <div class="flex items-center gap-4 text-sm" style="color: #C4A898">
          <div class="flex items-center gap-2">
            <span>作者：{post.data.author}</span>
          </div>
          <span>·</span>
          <div class="flex items-center gap-2">
            <span>{formatDate(post.data.pubDate)}</span>
          </div>
          <span>·</span>
          <div class="flex items-center gap-2">
            <span>预计阅读 {estimateReadTime(post.body)}</span>
          </div>
        </div>

        <!-- Hero Image -->
        {post.data.heroImage && (
          <div class="mt-8 rounded-xl overflow-hidden shadow-lg">
            <img
              src={post.data.heroImage}
              alt={post.data.title}
              class="w-full aspect-video object-cover"
            />
          </div>
        )}
      </div>
    </header>

    <!-- Article Content -->
    <article class="py-8 px-6 sm:px-8">
      <div class="max-w-3xl mx-auto">
        <div
          class="prose prose-lg max-w-none"
          style="color: #2C1810"
        >
          <Content />
        </div>
      </div>
    </article>

    <!-- Footer Section -->
    <footer class="py-12 px-6 sm:px-8 border-t" style="border-color: #F0EBE3">
      <div class="max-w-3xl mx-auto">
        <!-- Tags -->
        {post.data.tags && post.data.tags.length > 0 && (
          <div class="mb-6">
            <h3 class="text-sm font-semibold mb-2" style="color: #8B6F5E">标签</h3>
            <div class="flex flex-wrap gap-2">
              {post.data.tags.map((tag) => (
                <span
                  class="px-3 py-1 rounded-lg text-xs"
                  style="background: rgba(217, 119, 6, 0.08); color: #8B6F5E"
                >
                  {tag}
                </span>
              ))}
            </div>
          </div>
        )}

        <!-- Share & Back -->
        <div class="flex items-center justify-between">
          <a
            href="/blog"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg font-medium transition-all duration-200 hover:scale-105"
            style="background: rgba(217, 119, 6, 0.08); color: #D97706"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m15 18-6-6 6-6"/>
            </svg>
            返回博客列表
          </a>

          <!-- Share Button -->
          <button
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg font-medium transition-all duration-200 hover:scale-105"
            style="background: rgba(217, 119, 6, 0.08); color: #D97706"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="18" cy="5" r="3"/>
              <circle cx="6" cy="12" r="3"/>
              <circle cx="18" cy="19" r="3"/>
              <line x1="8.59" x2="15.42" y1="13.51" y2="17.49"/>
              <line x1="15.41" x2="8.59" y1="6.51" y2="10.49"/>
            </svg>
            分享文章
          </button>
        </div>
      </div>
    </footer>
  </div>
</Layout>

<style>
  .prose h2 {
    color: #2C1810;
    font-size: 1.75rem;
    font-weight: 700;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }

  .prose h3 {
    color: #2C1810;
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .prose p {
    color: #2C1810;
    line-height: 1.75;
    margin-bottom: 1rem;
  }

  .prose ul,
  .prose ol {
    color: #2C1810;
    margin-left: 1.5rem;
    margin-bottom: 1rem;
  }

  .prose li {
    margin-bottom: 0.5rem;
  }

  .prose blockquote {
    border-left: 4px solid #D97706;
    padding-left: 1rem;
    margin: 1.5rem 0;
    color: #8B6F5E;
    font-style: italic;
  }

  .prose code {
    background: rgba(217, 119, 6, 0.08);
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.875rem;
  }

  .prose pre {
    background: #2C1810;
    color: #FDFAF6;
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin: 1.5rem 0;
  }

  .prose pre code {
    background: transparent;
    padding: 0;
  }

  .prose a {
    color: #D97706;
    text-decoration: underline;
  }

  .prose strong {
    color: #2C1810;
    font-weight: 600;
  }

  .prose hr {
    border-color: #F0EBE3;
    margin: 2rem 0;
  }
</style>