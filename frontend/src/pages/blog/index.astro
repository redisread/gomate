---
title: "GoMate 博客"
description: "产品动态 · 用户故事 · 循步指南 · 活动回顾"
---

import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
import { copy } from "@/lib/copy";

const allPosts = await getCollection("blog");
const sortedPosts = allPosts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categoryLabels = {
  product: "产品动态",
  story: "用户故事",
  guide: "徒步指南",
  activity: "活动回顾",
};

const categoryColors = {
  product: "#3B82F6",
  story: "#10B981",
  guide: "#F59E0B",
  activity: "#8B5CF6",
};

function formatDate(date: Date) {
  return date.toLocaleDateString("zh-CN", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}

function estimateReadTime(content: string) {
  const words = content.split(/\s+/).length;
  const minutes = Math.ceil(words / 200);
  return `${minutes} 分钟`;
}
---

<Layout>
  <div class="min-h-screen" style="background: #FDFAF6">
    <!-- Hero Section -->
    <section class="relative py-20 px-6 sm:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full mb-6" style="background: rgba(217, 119, 6, 0.1); color: #D97706">
          <span class="text-sm font-medium">探索 · 发现 · 记录</span>
        </div>

        <!-- Title -->
        <h1 class="text-4xl sm:text-5xl font-bold mb-4" style="color: #2C1810">
          {copy.blog?.pageTitle || "GoMate 博客"}
        </h1>

        <!-- Subtitle -->
        <p class="text-lg sm:text-xl mb-8" style="color: #8B6F5E">
          {copy.blog?.pageSubtitle || "产品动态 · 用户故事 · 徒步指南 · 活动回顾"}
        </p>

        <!-- Category Filters -->
        <div class="flex flex-wrap justify-center gap-3 mb-12">
          {Object.entries(categoryLabels).map(([key, label]) => (
            <button
              class="px-4 py-2 rounded-lg font-medium text-sm transition-all duration-200 hover:scale-105"
              style={`background: rgba(${categoryColors[key].slice(1).match(/[0-9A-F]{2}/g).join(',')}, 0.1); color: ${categoryColors[key]}`}
            >
              {label}
            </button>
          ))}
        </div>
      </div>
    </section>

    <!-- Blog Posts Grid -->
    <section class="py-12 px-6 sm:px-8">
      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {sortedPosts.map((post) => (
            <article class="card-base overflow-hidden hover:shadow-lg transition-shadow duration-300">
              <!-- Hero Image -->
              {post.data.heroImage && (
                <div class="aspect-video overflow-hidden">
                  <img
                    src={post.data.heroImage}
                    alt={post.data.title}
                    class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                  />
                </div>
              )}

              <!-- Content -->
              <div class="p-6">
                <!-- Category Badge -->
                <div class="mb-3">
                  <span
                    class="inline-block px-3 py-1 rounded-full text-xs font-medium"
                    style={`background: rgba(${categoryColors[post.data.category].slice(1).match(/[0-9A-F]{2}/g).join(',')}, 0.1); color: ${categoryColors[post.data.category]}`}
                  >
                    {categoryLabels[post.data.category]}
                  </span>
                </div>

                <!-- Title -->
                <h2 class="text-xl font-semibold mb-2 line-clamp-2" style="color: #2C1810">
                  <a href={`/blog/${post.slug}`} class="hover:underline">
                    {post.data.title}
                  </a>
                </h2>

                <!-- Description -->
                <p class="text-sm mb-4 line-clamp-3" style="color: #8B6F5E">
                  {post.data.description}
                </p>

                <!-- Meta Info -->
                <div class="flex items-center justify-between text-xs" style="color: #C4A898">
                  <div class="flex items-center gap-2">
                    <span>{formatDate(post.data.pubDate)}</span>
                    <span>·</span>
                    <span>{estimateReadTime(post.body)}</span>
                  </div>
                  <a
                    href={`/blog/${post.slug}`}
                    class="font-medium hover:underline"
                    style="color: #D97706"
                  >
                    阅读全文
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>

        <!-- Empty State -->
        {sortedPosts.length === 0 && (
          <div class="text-center py-12">
            <p class="text-lg" style="color: #8B6F5E">暂无文章</p>
          </div>
        )}
      </div>
    </section>
  </div>
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>